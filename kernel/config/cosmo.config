# Cosmo Communicator config fragment, merged on top of arm64 defconfig by
# bin/build-kernel.sh (scripts/kconfig/merge_config.sh). P1 scope: boot to a
# shell on UART/framebuffer with eMMC. Later phases append here.

CONFIG_LOCALVERSION="-cosmo"
CONFIG_LOCALVERSION_AUTO=n

# SoC (MT6771 == MT8183 register map)
CONFIG_ARCH_MEDIATEK=y
CONFIG_COMMON_CLK_MT8183=y
CONFIG_PINCTRL_MT8183=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MTK_SCPSYS_PM_DOMAINS=y
CONFIG_MTK_INFRACFG=y
CONFIG_MTK_TIMER=y
CONFIG_MEDIATEK_WATCHDOG=y

# PMIC MT6358
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR_MT6358=y
CONFIG_RTC_DRV_MT6397=y
# Power-off via the MT6358 power hold (vendor ATF ignores PSCI SYSTEM_OFF;
# docs/poweroff.md)
CONFIG_POWER_RESET_MT6358=y
CONFIG_KEYBOARD_MTK_PMIC=y

# Console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
# Built-in so the LK framebuffer console appears before any module loads.
# (arm64 defconfig has DRM=m, which would cap simpledrm at m; FB_SIMPLE is
# mutually exclusive with simpledrm.)
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Hide LK's orange-state text (OVL layer 3) above the console
CONFIG_MTK_LK_OVERLAY_CLEAR=y

# eMMC
CONFIG_MMC=y
CONFIG_MMC_MTK=y
CONFIG_EXT4_FS=y

# Early userspace
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Debug for bring-up
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Framebuffer console readable on the rotated panel (fbcon=rotate:3,
# fbcon=font:TER16x32 in the boot cmdline, as on the Gemini)
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# ramoops in the vendor pstore region (DTS), built in so the console is
# captured from early boot
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Bring-up networking: legacy g_ether built in (binds to the mtu3 UDC with
# no userspace setup), CDC ECM only. Addresses on the boot cmdline.
CONFIG_USB_ETH=y
CONFIG_USB_ETH_RNDIS=n

# scpsys needs the DISP domain's clocks, which come from the mmsys driver
# ("power-domain@7: failed to get clk at index 1", on glass 2026-10-25).
# MTK_MMSYS is capped by MTK_CMDQ (Kconfig: depends on MTK_CMDQ || !MTK_CMDQ).
CONFIG_MTK_CMDQ=y
CONFIG_MTK_CMDQ_MBOX=y
CONFIG_MTK_MMSYS=y

# Built-in keyboard: AW9523 matrix driver following the stock scan
# (docs/keyboard-stock.md); built in: the Debian rootfs modules come from
# an earlier build
CONFIG_KEYBOARD_AW9523=y

# Power foundation S1 (docs/power-plan.md): measure only. MT6370 core + ADC,
# MT6358 AUXADC built in (the rootfs modules come from an earlier build).
# Charger, backlight, LEDs, regulators and TCPC drivers stay off (default n).
CONFIG_MFD_MT6370=y
CONFIG_MEDIATEK_MT6370_ADC=y
CONFIG_MEDIATEK_MT6359_AUXADC=y

# Power foundation S2 (docs/power-plan.md): SoC thermal, critical trips only.
# auxadc_thermal with the mt8183.dtsi zones (critical 115 C CPU, 100 C SoC
# sensors -> orderly power-off). No cpufreq yet, so passive trips have no
# cooling device. The thermal efuse words match stock (session-log).
CONFIG_MTK_THERMAL=y
CONFIG_MTK_SOC_THERMAL=y

# Power foundation S3 (docs/power-plan.md): charger as the vendor kernel,
# battery NTC thermal zone. Charger delta: drivers/power/supply/mt6370-charger.c
CONFIG_CHARGER_MT6370=y
CONFIG_GENERIC_ADC_THERMAL=y

# MT6358 fuel gauge, measurements only (power S4a, delta driver)
CONFIG_BATTERY_MT6358_GAUGE=y
# Wi-Fi W1b: stock MediaTek connectivity port (docs/wifi-stock.md). The W1a
# power-on check module matches the same node and stays off.
# CONFIG_MT6771_CONSYS is not set
# CONFIG_CFG80211_WEXT is not set
CONFIG_NL80211_TESTMODE=y
CONFIG_MTK_WCN_CONSYS=m
CONFIG_MTK_WCN_GEN3=m
