	};

	cosmo_cci_opp: opp-table-cosmo-cci {
		compatible = "operating-points-v2";
		opp-shared;

		cosmo_cci_273: opp-273000000 {
			opp-hz = /bits/ 64 <273000000>;
			opp-microvolt = <600000>;
		};
		cosmo_cci_338: opp-338000000 {
