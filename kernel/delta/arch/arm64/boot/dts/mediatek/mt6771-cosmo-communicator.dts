	/*
	 * CONSYS (on-die Wi-Fi/BT/GPS, A-die MT6631), vendor mt6771.dts
	 * consys@18070000 (docs/wifi-stock.md). reg as stock: CONN_MCU_CONFIG,
	 * TOP_RGU, INFRACFG_AO, SPM (the driver maps, never claims, the
	 * shared ones). Supplies at the stock voltages (vcn33 set to 3.5 V by
	 * the driver). The CONN MTCMOS is switched by the driver itself: the
	 * mainline scpsys controller does not probe on this board yet.
	 */
	consys: consys@18070000 {
		compatible = "mediatek,mt6771-consys";
		reg = <0 0x18070000 0 0x1000>,	/* CONN_MCU_CONFIG */
		      <0 0x10007000 0 0x0100>,	/* TOP_RGU */
		      <0 0x10001000 0 0x1000>,	/* INFRACFG_AO */
		      <0 0x10006000 0 0x1000>;	/* SPM */
		interrupts = <GIC_SPI 289 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_SPI 291 IRQ_TYPE_LEVEL_LOW>;
		memory-region = <&consys_mem>;
		resets = <&watchdog MT8183_TOPRGU_CONN_MCU_SW_RST>;
		reset-names = "mcu";
		vcn18-supply = <&mt6358_vcn18_reg>;
		vcn28-supply = <&mt6358_vcn28_reg>;
		vcn33-supply = <&mt6358_vcn33_reg>;
		pinctrl-names = "on", "off";
		pinctrl-0 = <&consys_pins_on>;
		pinctrl-1 = <&consys_pins_off>;
	};

	/* AP <-> CONSYS MCU transport, vendor mt6771.dts btif@1100c000 */
	btif@1100c000 {
		compatible = "mediatek,btif";
		reg = <0 0x1100c000 0 0x1000>,	/* BTIF */
		      <0 0x11000a80 0 0x80>,	/* TX DMA */
		      <0 0x11000b00 0 0x80>;	/* RX DMA */
		interrupts = <GIC_SPI 114 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_SPI 139 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_SPI 140 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&infracfg CLK_INFRA_BTIF>,
			 <&infracfg CLK_INFRA_AP_DMA>;
		clock-names = "btifc", "apdmac";
	};

	/* CONSYS Wi-Fi data path, vendor mt6771.dts wifi@180f0000 */
	wifi@180f0000 {
		compatible = "mediatek,wifi";
		reg = <0 0x180f0000 0 0x1100>,	/* WIFI-HIF */
		      <0 0x10212180 0 0x006c>,	/* CQDMA */
		      <0 0x10001000 0 0x1000>,	/* INFRACFG_AO */
		      <0 0x180e0000 0 0x0070>;	/* CONN remap config */
		interrupts = <GIC_SPI 290 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_SPI 118 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&infracfg CLK_INFRA_CQ_DMA>;
		clock-names = "wifi-dma";
		hardware-values = <0x00000788>,	/* HW code */
				  <0x000a5800>,	/* FW load addr */
				  <0x000a5800>;	/* FW start addr */
	};
};

/*
 * MT6358 interrupt: GPIO 182, level high. Vendor DT: main_pmic pmic_irq
 * "interrupts = <0xb6 0x04 ...>" on pio; same as mt8183-kukui.dtsi. Without
 * it the MFD fails ("IRQ index 0 not found", on glass 2026-10-25), so no
 * MT6358 regulators, and the eMMC never gets its supplies.
 */
&pmic {
	interrupts-extended = <&pio 182 IRQ_TYPE_LEVEL_HIGH>;

	/*
	 * Power-off: the vendor ATF ignores PSCI SYSTEM_OFF. mt6358-poweroff
	 * runs the vendor RTC power-down sequence and releases RG_PWRHOLD;
	 * its fallback resets through TOPRGU without "bypass power key"
	 * (docs/poweroff.md). status = "disabled" turns it off.
	 */
	mt6358_pwrc: pwrc {
		compatible = "mediatek,mt6358-pwrc";
		mediatek,toprgu = <&watchdog>;
	};

	/*
	 * Fuel gauge, measurements only (drivers/power/supply/
	 * mt6358-gauge.c, docs/power-stock.md "MT6358 fuel gauge
	 * hardware"). CAR_TUNE 930 and R_FG 10 mOhm (= no scaling) as the
	 * vendor mt6771_battery_prop.dtsi.
	 */
	mt6358_gauge: gauge {
		compatible = "mediatek,mt6358-gauge";
		io-channels = <&pmic_adc MT6358_AUXADC_BATADC>;
		io-channel-names = "batadc";
		monitored-battery = <&cosmo_battery>;
		power-supplies = <&mt6370_chg>;
		mediatek,car-tune = <930>;
		/*
		 * Usable capacity for the state of charge: 4050 mAh measured
		 * empty to full at 4.4 V on the same cell in the Gemini PDA
		 * (docs/power-stock.md "Battery level"); label 4220 mAh.
		 */
		cosmo,charge-full-microamp-hours = <4050000>;
	};
};

/*
 * PMIC keys (stock: kpd_sw_pwrkey 116 = KEY_POWER, kpd_sw_rstkey 115 =
 * KEY_VOLUMEUP on the home-key input). The driver delta uses the MT6358
 * TOP_RST_MISC layout (vendor upmu_hw.h; docs/p0-findings.md); mainline's
 * MT6397 layout cleared RG_PWRKEY_RST_EN and stranded the board twice
 * (2026-10-25). Stock kernel (hal_kpd.c, all MT6771 defconfigs
 * CONFIG_ONEKEY_REBOOT_NORMAL_MODE) sets PWRKEY_RST_EN 1, HOMEKEY_RST_EN 0;
 * live value under mainline 0x1225 (the preloader's 0x1325 is overwritten).
 * long-press-mode 1 + power-off-time-sec 1 write bits 13:12 = 1, 9 = 1,
 * 8 = 0: the same value, so the ~8 s power-key hold reset stays. Not a wake source yet (sleep wake sources are
 * separate work). bin/build-boot-img.sh checks these values.
 */
&mt6358keys {
	mediatek,long-press-mode = <1>;
	power-off-time-sec = <1>;

	power {
		/delete-property/ wakeup-source;
	};

	home {
		linux,keycodes = <KEY_VOLUMEUP>;
	};
};

/*
 * GPU power-domain supplies, as mt8183-kukui.dtsi. Missing, the whole
 * scpsys power controller fails to probe ("power-domain@2: failed to get
 * power supply", on glass 2026-10-25). The order matches stock
 * (mtk_gpufreq_core.c): VSRAM_GPU on, then VGPU, then MFG_ASYNC, MFG,
 * CORE0..2; off in reverse.
 */
&mfg_async {
	domain-supply = <&mt6358_vsram_gpu_reg>;
};

&mfg {
	domain-supply = <&mt6358_vgpu_reg>;
};

/*
 * GPU rails (GPU G2). Stock MT6771 GPU DVFS table for this unit: efuse
 * 0x11f10050 = 0x2200000c (speed bin 0x02, turbo bit 3 set) selects
 * segment 4, 300 MHz / VGPU 0.625 V up to 900 MHz / 0.900 V, VSRAM_GPU
 * 0.850 V up to 1.000 V. Stock sets VSRAM_GPU = max(VGPU + 100 mV,
 * 0.850 V); mtk-regulator-coupler does the same from these limits.
 */
&mt6358_vgpu_reg {
	regulator-min-microvolt = <625000>;
	regulator-max-microvolt = <900000>;

	regulator-coupled-with = <&mt6358_vsram_gpu_reg>;
	regulator-coupled-max-spread = <100000>;
};

&mt6358_vsram_gpu_reg {
	regulator-min-microvolt = <850000>;
	regulator-max-microvolt = <1000000>;

	regulator-coupled-with = <&mt6358_vgpu_reg>;
	regulator-coupled-max-spread = <100000>;
};

/*
 * USB device mode for bring-up networking (g_ether, CDC ECM). The SoC port
 * is the one the preloader enumerates on. High speed only for now.
 */
&ssusb {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	/*
	 * USB 2 only: without this mtu3 also waits for the U3 MAC clock
	 * (IPPC STS1 bit 16), which never starts here (try15: STS1 0x1000d0f).
	 */
	mediatek,u3p-dis-msk = <0x1>;
	vusb33-supply = <&mt6358_vusb_reg>;
	status = "okay";
};

&mmc0 {
	/* vendor cust_mt6771_msdc.dtsi: 8-bit, 200 MHz, HS200/HS400 1.8 V, VEMC */
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	bus-width = <8>;
	/*
	 * Start at HS200 only; HS400 (and its ds-delay tuning) comes in P2
	 * once the basic path is proven on glass.
	 */
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	cap-mmc-hw-reset;
	no-sdio;
	no-sd;
	vmmc-supply = <&mt6358_vemc_reg>;
	vqmmc-supply = <&mt6358_vio18_reg>;
	assigned-clocks = <&topckgen CLK_TOP_MUX_MSDC50_0>;
	assigned-clock-parents = <&topckgen CLK_TOP_MSDCPLL_CK>;
	non-removable;
};

&pio {
	aw9523_int_pins: aw9523-int-pins {
		pins-int {
			pinmux = <PINMUX_GPIO12__FUNC_GPIO12>;
			input-enable;
			bias-pull-up;
		};
	};

	/* MSDC0 pins are fixed on the die; identical to mt8183-kukui.dtsi */
	mmc0_pins_default: mmc0-default-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO123__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO128__FUNC_MSDC0_DAT1>,
				 <PINMUX_GPIO125__FUNC_MSDC0_DAT2>,
				 <PINMUX_GPIO132__FUNC_MSDC0_DAT3>,
				 <PINMUX_GPIO126__FUNC_MSDC0_DAT4>,
				 <PINMUX_GPIO129__FUNC_MSDC0_DAT5>,
				 <PINMUX_GPIO127__FUNC_MSDC0_DAT6>,
				 <PINMUX_GPIO130__FUNC_MSDC0_DAT7>,
				 <PINMUX_GPIO122__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-up-adv = <01>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO124__FUNC_MSDC0_CLK>;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-down-adv = <2>;
		};

		pins-rst {
			pinmux = <PINMUX_GPIO133__FUNC_MSDC0_RSTB>;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-down-adv = <01>;
		};
	};

	mmc0_pins_uhs: mmc0-uhs-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO123__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO128__FUNC_MSDC0_DAT1>,
				 <PINMUX_GPIO125__FUNC_MSDC0_DAT2>,
				 <PINMUX_GPIO132__FUNC_MSDC0_DAT3>,
				 <PINMUX_GPIO126__FUNC_MSDC0_DAT4>,
				 <PINMUX_GPIO129__FUNC_MSDC0_DAT5>,
				 <PINMUX_GPIO127__FUNC_MSDC0_DAT6>,
				 <PINMUX_GPIO130__FUNC_MSDC0_DAT7>,
				 <PINMUX_GPIO122__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-up-adv = <01>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO124__FUNC_MSDC0_CLK>;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-down-adv = <2>;
		};

		pins-ds {
			pinmux = <PINMUX_GPIO131__FUNC_MSDC0_DSL>;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-down-adv = <2>;
		};

		pins-rst {
			pinmux = <PINMUX_GPIO133__FUNC_MSDC0_RSTB>;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-down-adv = <01>;
		};
	};

	/* vendor k71v1_64_bsp.dts &apuart0: RX GPIO95, TX GPIO96 */
	uart0_pins_default: uart0-pins {
		pins-rx {
			pinmux = <PINMUX_GPIO95__FUNC_URXD0>;
			input-enable;
			bias-pull-up;
		};

		pins-tx {
			pinmux = <PINMUX_GPIO96__FUNC_UTXD0>;
		};
	};

	/*
	 * CONSYS A-die interface, stock consys_set_if_pinmux(): GPIO_MODE
	 * 0x3e0/0x3f0 set GPIO113-121 to mode 1 at power-on and back to 0
	 * at power-off. Mux only, no pin config (stock writes mode only).
	 */
	consys_pins_on: consys-on-pins {
		pins-conn {
			pinmux = <PINMUX_GPIO113__FUNC_CONN_TOP_CLK>,
				 <PINMUX_GPIO114__FUNC_CONN_TOP_DATA>,
				 <PINMUX_GPIO115__FUNC_CONN_BT_CLK>,
				 <PINMUX_GPIO116__FUNC_CONN_BT_DATA>,
				 <PINMUX_GPIO117__FUNC_CONN_WF_HB0>,
				 <PINMUX_GPIO118__FUNC_CONN_WF_HB1>,
				 <PINMUX_GPIO119__FUNC_CONN_WF_HB2>,
				 <PINMUX_GPIO120__FUNC_CONN_WB_PTA>,
				 <PINMUX_GPIO121__FUNC_CONN_HRST_B>;
		};
	};

	consys_pins_off: consys-off-pins {
		pins-conn {
			pinmux = <PINMUX_GPIO113__FUNC_GPIO113>,
				 <PINMUX_GPIO114__FUNC_GPIO114>,
				 <PINMUX_GPIO115__FUNC_GPIO115>,
				 <PINMUX_GPIO116__FUNC_GPIO116>,
				 <PINMUX_GPIO117__FUNC_GPIO117>,
				 <PINMUX_GPIO118__FUNC_GPIO118>,
				 <PINMUX_GPIO119__FUNC_GPIO119>,
				 <PINMUX_GPIO120__FUNC_GPIO120>,
				 <PINMUX_GPIO121__FUNC_GPIO121>;
		};
	};
};

/*
 * Keyboard expanders. Pin mux (SCL/SDA, pull-ups) is left as the
 * preloader sets it (GPIO50/51 = SCL3/SDA3, GPIO105/106 = SCL4/SDA4, read
 * live 2026-10-25). Both expanders are held in reset by their HWEN lines
 * (GPIO175, GPIO109: output low) until a driver releases them.
 */
&i2c4 {
	/*
	 * MT6771 i2c4 is a multi-channel controller: vendor mt6771.dts has
	 * ch_offset_default = <0x100> (AP channel) and ccu-ch-offset 0x200
	 * (camera CCU), so the AP's registers start at +0x100. Mainline
	 * i2c-mt65xx has no channel offset: the base moves instead. With the
	 * mt8183.dtsi base (0x11008000) every transfer timed out with zero
	 * controller interrupts (try23/try24).
	 */
	reg = <0 0x11008100 0 0x100>,
	      <0 0x11000100 0 0x80>;
	/*
	 * Vendor bus id 4 for the secure channel-mode restore after deep
	 * sleep (vendor i2c-mtk.c resume; without it the keyboard times out).
	 */
	mediatek,sec-mch-id = <4>;
	clock-frequency = <100000>;
	status = "okay";

	/*
	 * Built-in keyboard: 8 x 7 matrix on the AW9523 (stock: 4-005b
	 * "Integrated keyboard", vendor aw9523_key.c). Rows = P0_0..7,
	 * columns = P1_0..6; keymap = vendor key_map[] (docs/keyboard-stock.md).
	 * Stock interrupt: EINT 12 level-low, GPIO12 pull-up (dtbo fragment@59
	 * and aw9523pin). Reset: GPIO175, low = reset (aw9523_hwen_low).
	 */
	keyboard@5b {
		compatible = "awinic,aw9523-keypad";
		reg = <0x5b>;
		pinctrl-names = "default";
		pinctrl-0 = <&aw9523_int_pins>;
		interrupts-extended = <&pio 12 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&pio 175 GPIO_ACTIVE_LOW>;
		keypad,num-rows = <8>;
		keypad,num-columns = <7>;
		linux,keymap = <
			/* col 0 (P1_0) */
			MATRIX_KEY(0, 0, KEY_1)
			MATRIX_KEY(1, 0, KEY_U)
			MATRIX_KEY(2, 0, KEY_S)
			MATRIX_KEY(3, 0, KEY_Z)
			MATRIX_KEY(4, 0, KEY_COMMA)
			MATRIX_KEY(5, 0, KEY_APOSTROPHE)
			MATRIX_KEY(6, 0, KEY_8)
			MATRIX_KEY(7, 0, KEY_J)
			/* col 1 (P1_1) */
			MATRIX_KEY(0, 1, KEY_2)
			MATRIX_KEY(1, 1, KEY_W)
			MATRIX_KEY(2, 1, KEY_D)
			MATRIX_KEY(3, 1, KEY_C)
			MATRIX_KEY(4, 1, KEY_LEFTALT)
			MATRIX_KEY(5, 1, KEY_LEFT)
			MATRIX_KEY(6, 1, KEY_9)
			MATRIX_KEY(7, 1, KEY_K)
			/* col 2 (P1_2) */
			MATRIX_KEY(0, 2, KEY_3)
			MATRIX_KEY(1, 2, KEY_Y)
			MATRIX_KEY(2, 2, KEY_TAB)
			MATRIX_KEY(3, 2, KEY_N)
			MATRIX_KEY(4, 2, KEY_M)
			MATRIX_KEY(5, 2, KEY_DOWN)
			MATRIX_KEY(6, 2, KEY_BACKSPACE)
			MATRIX_KEY(7, 2, KEY_I)
			/* col 3 (P1_3) */
			MATRIX_KEY(0, 3, KEY_4)
			MATRIX_KEY(1, 3, KEY_T)
			MATRIX_KEY(2, 3, KEY_F)
			MATRIX_KEY(3, 3, KEY_X)
			MATRIX_KEY(4, 3, KEY_LEFTMETA)	/* Fn, as stock */
			MATRIX_KEY(5, 3, KEY_RIGHTSHIFT)
			MATRIX_KEY(6, 3, KEY_P)
			/* col 4 (P1_4) */
			MATRIX_KEY(0, 4, KEY_5)
			MATRIX_KEY(1, 4, KEY_E)
			MATRIX_KEY(2, 4, KEY_G)
			MATRIX_KEY(3, 4, KEY_V)
			MATRIX_KEY(4, 4, KEY_SPACE)
			MATRIX_KEY(5, 4, KEY_UP)
			MATRIX_KEY(6, 4, KEY_O)
			/* col 5 (P1_5) */
			MATRIX_KEY(0, 5, KEY_6)
			MATRIX_KEY(1, 5, KEY_Q)
			MATRIX_KEY(2, 5, KEY_A)
			MATRIX_KEY(3, 5, KEY_B)
			MATRIX_KEY(4, 5, KEY_DOT)
			MATRIX_KEY(5, 5, KEY_RIGHT)
			MATRIX_KEY(6, 5, KEY_ENTER)
			/* col 6 (P1_6) */
			MATRIX_KEY(0, 6, KEY_7)
			MATRIX_KEY(1, 6, KEY_R)
			MATRIX_KEY(2, 6, KEY_H)
			MATRIX_KEY(3, 6, KEY_LEFTSHIFT)
			MATRIX_KEY(4, 6, KEY_LEFTCTRL)
			MATRIX_KEY(5, 6, KEY_L)
			MATRIX_KEY(6, 6, KEY_0)
		>;
	};
};

/*
 * MT6370 sub-PMIC (charger, Type-C TCPC, backlight, ADC) on vendor i2c5 =
 * mainline &i2c11 (0x11017000, single-channel: vendor mt6771.dts has no
 * ch_offset for i2c5). Stock runs this bus at 3.4 MHz HS (live DT
 * clock-frequency 0x33e140, mediatek,hs_only); 400 kHz is used here.
 * Pin mux left as the preloader sets it (LK talks to the MT6370 on it).
 * PMU interrupt: GPIO10 = EINT 10 level-low (live /mt6370_pmu_eint).
 * docs/power-stock.md, docs/power-plan.md S1.
 *
 * Children: ADC (S1), charger (S3), general indicator sinks, and (D1) the
 * display bias (DSV) regulators and the backlight. TCPC and flashlight are
 * left out on purpose and their drivers are not built.
 */
&i2c11 {
	clock-frequency = <400000>;
	status = "okay";

	mt6370: pmic@34 {
		compatible = "mediatek,mt6370";
		reg = <0x34>;
		interrupts-extended = <&pio 10 IRQ_TYPE_LEVEL_LOW>;
		interrupt-controller;
		#interrupt-cells = <1>;

		/*
		 * Stock names sinks 1/2 green/blue; physical mapping is unknown.
		 * Sink 3 uses white only as a required binding placeholder.
		 * Labels identify channels, not observed colours or positions.
		 * Omit ISNK4 to preserve automatic charging indication.
		 */
		led-controller {
			compatible = "mediatek,mt6370-indicator";
			#address-cells = <1>;
			#size-cells = <0>;

			led@0 {
				reg = <0>;
				color = <LED_COLOR_ID_GREEN>;
				label = "cosmo:mt6370:isnk1";
				led-max-microamp = <4000>;
				default-state = "off";
			};

			led@1 {
				reg = <1>;
				color = <LED_COLOR_ID_BLUE>;
				label = "cosmo:mt6370:isnk2";
				led-max-microamp = <4000>;
				default-state = "off";
			};

			led@2 {
				reg = <2>;
				color = <LED_COLOR_ID_WHITE>;
				label = "cosmo:mt6370:isnk3";
				led-max-microamp = <4000>;
				default-state = "off";
			};
		};

		mt6370_adc: adc {
			compatible = "mediatek,mt6370-adc";
			#io-channel-cells = <1>;
		};

		/*
		 * Panel bias (stock lcm_pmic.c display_bias_enable: dsv_pos and
		 * dsv_neg at 5.4 V; boost db_vbst 5.7 V). Enabled over I2C
		 * (DB_CTRL2 bits 6/3); stock does not use the external enable
		 * pins (db_ext_en = 0, empty ENN/ENP pinctrl). LK leaves both
		 * on; the voltages below equal what LK set, so registration
		 * writes nothing. No consumer yet: regulator_ignore_unused on
		 * the cmdline keeps them on until the panel driver owns them.
		 * The readable enable bits are the bias-off check for suspend.
		 */
		regulators {
			mt6370_dsvbst: dsvbst {
				regulator-name = "mt6370-dsvbst";
				regulator-min-microvolt = <5700000>;
				regulator-max-microvolt = <5700000>;
			};

			mt6370_dsvpos: dsvpos {
				regulator-name = "mt6370-dsvpos";
				regulator-min-microvolt = <5400000>;
				regulator-max-microvolt = <5400000>;
			};

			mt6370_dsvneg: dsvneg {
				regulator-name = "mt6370-dsvneg";
				regulator-min-microvolt = <5400000>;
				regulator-max-microvolt = <5400000>;
			};
		};

		/*
		 * LCD backlight, stock limits (docs/power-stock.md "Backlight"):
		 * 4 channels, OVP 29 V and OCP 1.5 A with shutdown (equal to
		 * LK's BL_BSTCTRL 0xed), linear mode, stock cap 768 of 2048.
		 * Dimming is I2C only: no mediatek,bled-pwm-enable, so the
		 * SoC DISP_PWM input is switched off at probe (driver delta).
		 * default-brightness = LK's level (0x1a4/0x1a5 = 05/5f).
		 */
		mt6370_backlight: backlight {
			compatible = "mediatek,mt6370-backlight";
			mediatek,bled-channel-use = /bits/ 8 <0x0f>;
			mediatek,bled-ovp-shutdown;
			mediatek,bled-ovp-microvolt = <29000000>;
			mediatek,bled-ocp-shutdown;
			mediatek,bled-ocp-microamp = <1500000>;
			max-brightness = <768>;
			default-brightness = <766>;
		};

		/*
		 * Charger, run as the vendor kernel does (docs/power-stock.md):
		 * CV / IEOC / ICHG ceiling from &cosmo_battery, current by
		 * BC1.2 type, stop/resume on the battery-thermal zone (delta
		 * drivers/power/supply/mt6370-charger.c). The driver reads IBUS
		 * as the sixth io-channel, so all nine are listed in order.
		 */
		mt6370_chg: charger {
			compatible = "mediatek,mt6370-charger";
			interrupts = <68>, <48>, <6>;
			interrupt-names = "uvp_d_evt", "attach_i", "mivr";
			io-channels = <&mt6370_adc MT6370_CHAN_VBUSDIV5>,
				      <&mt6370_adc MT6370_CHAN_VBUSDIV2>,
				      <&mt6370_adc MT6370_CHAN_VSYS>,
				      <&mt6370_adc MT6370_CHAN_VBAT>,
				      <&mt6370_adc MT6370_CHAN_TS_BAT>,
				      <&mt6370_adc MT6370_CHAN_IBUS>,
				      <&mt6370_adc MT6370_CHAN_IBAT>,
				      <&mt6370_adc MT6370_CHAN_CHG_VDDP>,
				      <&mt6370_adc MT6370_CHAN_TEMP_JC>;
			monitored-battery = <&cosmo_battery>;
			/*
			 * USB2 PHY port 0 USBPHYACR6 (t-phy 0x11f40000 + COM
			 * 0x300 + 0x18), bit 23 BC11_SW_EN: vendor mu3phy
			 * mt6771 Charger_Detect_Init / Release.
			 */
			cosmo,u2phy-bc11-reg = <0x11f40318>;
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins_default>;
	status = "okay";
};

/*
 * Nothing that drives the GPU, media engines or CPU voltages probes until
 * it is brought up on purpose (AGENTS.md rule 3). The display pipeline
 * is enabled further down (display D2); the second path (OVL_2L1,
 * RDMA1, DPI) stays off.
 * The Debian rootfs carries every defconfig module, so an enabled
 * mt8183.dtsi node gets its driver loaded (try21: mediatek-drm, the
 * disp-pwm backlight, mipi-tx, panfrost and the mdp3/vcodec/jpeg probes
 * with WARN traces). The M4U and SMI sit in the display's memory path:
 * keep them out of the way of LK's running scanout too.
 */

/*
 * Display D2: mainline mediatek-drm main path OVL0 -> OVL_2L0 -> RDMA0 ->
 * COLOR -> CCORR -> AAL -> GAMMA -> DITHER -> DSI0 -> NT36672 panel.
 *
 * M4U stays as LK left it: without iommus the display scans out
 * physical buffers from CMA, as LK does.
 *
 * Sleep D1: the scpsys power controller manages the DISP domain.
 * Its probe powers on every listed domain, so AUDIO and CONN (the Wi-Fi
 * driver controls it itself) are disabled and the DISP sub-domains are
 * deleted (sub-domains are added even when disabled). Since GPU G2 it
 * also manages the MFG domains for panfrost; genpd switches them off
 * when the GPU is idle and in suspend (stock sleep checks MFG is off).
 * Powering on the already-on DISP domain only sets bits LK already set.
 * The display nodes carry DISP again, so genpd switches the domain off in
 * the noirq phase of system suspend (stock refuses to sleep with DIS on)
 * and on again before the display resumes. DSI, COLOR, CCORR, AAL, GAMMA,
 * DITHER and MUTEX have no runtime PM, so DISP never goes off at runtime.
 */
&spm {
	power-domain@MT8183_POWER_DOMAIN_AUDIO {
		status = "disabled";
	};

	power-domain@MT8183_POWER_DOMAIN_CONN {
		status = "disabled";
	};

	power-domain@MT8183_POWER_DOMAIN_DISP {
		/delete-property/ #address-cells;
		/delete-property/ #size-cells;
		/delete-node/ power-domain@MT8183_POWER_DOMAIN_CAM;
		/delete-node/ power-domain@MT8183_POWER_DOMAIN_ISP;
		/delete-node/ power-domain@MT8183_POWER_DOMAIN_VDEC;
		/delete-node/ power-domain@MT8183_POWER_DOMAIN_VENC;
		/delete-node/ power-domain@MT8183_POWER_DOMAIN_VPU_TOP;
	};
};

&mipi_tx0 {
	status = "okay";
};

&ovl0 {
	/delete-property/ iommus;
};

&ovl_2l0 {
	/delete-property/ iommus;
};

&rdma0 {
	/delete-property/ iommus;
};

/*
 * Panel: NT36672 (LK ID 0x8070), stock timings and sequences in the
 * driver (drivers/gpu/drm/panel/panel-cosmo-nt36672.c). Bias = MT6370
 * DSV over I2C. Reset = GPIO45 (stock LCM_RST pad function, MMSYS
 * LCM_RST_B 0x150); switched to GPIO mode, output high as LK leaves it,
 * so the bootloader picture stays until the first panel power-on.
 * Physical rotation 270 (docs/p0-findings.md).
 */
&dsi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel: panel@0 {
		compatible = "planet,cosmo-nt36672";
		reg = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&panel_pins_default>;
		reset-gpios = <&pio 45 GPIO_ACTIVE_LOW>;
		vsp-supply = <&mt6370_dsvpos>;
		vsn-supply = <&mt6370_dsvneg>;
		backlight = <&mt6370_backlight>;
		rotation = <270>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

&dsi_out {
	remote-endpoint = <&panel_in>;
};

&pio {
	panel_pins_default: panel-pins-default {
		pins-reset {
			pinmux = <PINMUX_GPIO45__FUNC_GPIO45>;
			output-high;
		};
	};
};

&svs {
	status = "disabled";
};

&pwm0 {
	status = "disabled";
};

/*
 * GPU: Mali-G72 MP3 with panfrost. Full stock segment-4 table (G3):
 * 300 MHz / 0.625 V to 900 MHz / 0.900 V, VGPU as stock at every OPP;
 * the coupler sets VSRAM_GPU 0.850-1.000 V. Mainline mt8183 (stock
 * segment 2) has the same voltage at every shared frequency.
 */
&gpu {
	mali-supply = <&mt6358_vgpu_reg>;
	operating-points-v2 = <&cosmo_gpu_opp>;
	status = "okay";
};

/ {
	cosmo_gpu_opp: opp-table-cosmo-gpu {
		compatible = "operating-points-v2";
		opp-shared;

		opp-300000000 {
			opp-hz = /bits/ 64 <300000000>;
			opp-microvolt = <625000>;
		};
		opp-320000000 {
			opp-hz = /bits/ 64 <320000000>;
			opp-microvolt = <631250>;
		};
		opp-340000000 {
			opp-hz = /bits/ 64 <340000000>;
			opp-microvolt = <637500>;
		};
		opp-380000000 {
			opp-hz = /bits/ 64 <380000000>;
			opp-microvolt = <650000>;
		};
		opp-420000000 {
			opp-hz = /bits/ 64 <420000000>;
			opp-microvolt = <662500>;
		};
		opp-460000000 {
			opp-hz = /bits/ 64 <460000000>;
			opp-microvolt = <675000>;
		};
		opp-500000000 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <687500>;
		};
		opp-540000000 {
			opp-hz = /bits/ 64 <540000000>;
			opp-microvolt = <700000>;
		};
		opp-580000000 {
			opp-hz = /bits/ 64 <580000000>;
			opp-microvolt = <712500>;
		};
		opp-620000000 {
			opp-hz = /bits/ 64 <620000000>;
			opp-microvolt = <725000>;
		};
		opp-653000000 {
			opp-hz = /bits/ 64 <653000000>;
			opp-microvolt = <743750>;
		};
		opp-698000000 {
			opp-hz = /bits/ 64 <698000000>;
			opp-microvolt = <768750>;
		};
		opp-743000000 {
			opp-hz = /bits/ 64 <743000000>;
			opp-microvolt = <793750>;
		};
		opp-800000000 {
			opp-hz = /bits/ 64 <800000000>;
			opp-microvolt = <825000>;
		};
		opp-850000000 {
			opp-hz = /bits/ 64 <850000000>;
			opp-microvolt = <862500>;
		};
		opp-900000000 {
			opp-hz = /bits/ 64 <900000000>;
			opp-microvolt = <900000>;
		};
	};
};

&ovl_2l1 {
	status = "disabled";
};

&rdma1 {
	status = "disabled";
};

&{/soc/dma-controller0@14001000} {
	status = "disabled";
};

&{/soc/mdp3-rsz0@14003000} {
	status = "disabled";
};

&{/soc/mdp3-rsz1@14004000} {
	status = "disabled";
};

&{/soc/dma-controller@14005000} {
	status = "disabled";
};

&{/soc/mdp3-wdma@14006000} {
	status = "disabled";
};

&{/soc/mdp3-ccorr@1401c000} {
	status = "disabled";
};

&vcodec_dec {
	status = "disabled";
};

&vcodec_enc {
	status = "disabled";
};

&venc_jpg {
	status = "disabled";
};

&iommu {
	status = "disabled";
};

&smi_common {
	status = "disabled";
};

&larb0 {
	status = "disabled";
};

&larb1 {
	status = "disabled";
};

&larb2 {
	status = "disabled";
};

&larb3 {
	status = "disabled";
};

&larb4 {
	status = "disabled";
};

&larb5 {
	status = "disabled";
};

&larb6 {
	status = "disabled";
};

/*
 * Battery (same cell as the Gemini PDA; label: 3.85 V, 4220 mAh, charge
 * 4.4 V). CV 4.40 V and IEOC 150 mA as the vendor mt6370.dtsi; charge
 * current ceiling 2.0 A = what the vendor kernel actually set on a wall
 * charger (CHGCTRL7 0x4c, docs/power-stock.md). The node name "battery"
 * is taken by LK's mediatek,bat_gm30 data above.
 */
/ {
	/*
	 * Refuse system sleep while the panel bias is on (stock blanks the
	 * display and drops the bias before every suspend). Read-only.
	 */
	/*
	 * Sleep D1b: saves LK's SMI common + larb0 settings (larb0 ports 0-5
	 * MMU off) before DISP powers off in suspend, restores them after.
	 */
	smi-restore@14019000 {
		compatible = "planet,cosmo-smi-restore";
		reg = <0 0x14019000 0 0x1000>, <0 0x14017000 0 0x1000>;
		power-domains = <&spm MT8183_POWER_DOMAIN_DISP>;
	};

	sleep-guard {
		compatible = "planet,cosmo-sleep-guard";
		vpos-supply = <&mt6370_dsvpos>;
		vneg-supply = <&mt6370_dsvneg>;
	};

	cosmo_battery: cosmo-battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		charge-full-design-microamp-hours = <4220000>;
		voltage-min-design-microvolt = <3400000>;
		constant-charge-voltage-max-microvolt = <4400000>;
		constant-charge-current-max-microamp = <2000000>;
		charge-term-current-microamp = <150000>;
		/*
		 * Open-circuit voltage vs charge at 25 C from the vendor
		 * profile LK reads (battery node battery0_profile_t1, 100
		 * points, 4276 mAh to the 3.4 V vendor shutdown voltage),
		 * resampled every 5 %. Internal resistance = median of the
		 * same profile's R column (1710 x 0.1 mOhm).
		 */
		factory-internal-resistance-micro-ohms = <171000>;
		ocv-capacity-celsius = <25>;
		ocv-capacity-table-0 = <4364700 100>, <4307738 95>, <4250257 90>,
			<4193951 85>, <4139579 80>, <4085569 75>, <4041962 70>,
			<3975218 65>, <3942225 60>, <3888570 55>, <3854918 50>,
			<3829530 45>, <3809101 40>, <3792343 35>, <3777941 30>,
			<3760051 25>, <3741748 20>, <3717371 15>, <3689590 10>,
			<3677794 5>, <3400000 0>;
	};

	/*
	 * Battery NTC on MT6358 AUXADC BAT_TEMP (vendor channel 3 in
	 * pmic_auxadc.c, 10 k NTC, 24 k pull-up to VBIF28 = 2.8 V,
	 * mtk_battery_table.h Fg_Temperature_Table). The mt6359-auxadc
	 * driver reports scale = full-scale mV (3600, not 3600/4096), so
	 * its "processed" value is mV x 4096: the table is in those units
	 * (V = 2800 x R / (24000 + R), value = V x 4096). Checked: raw 891
	 * (Gemian AUXADC_ADC3) gives 27.0 C, as stock reported.
	 */
	battery_ntc: thermal-sensor-battery {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0>;
		io-channels = <&pmic_adc MT6358_AUXADC_BAT_TEMP>;
		io-channel-names = "sensor-channel";
		temperature-lookup-table = <
			(-40000) 10215676
			(-35000) 9870092
			(-30000) 9464743
			(-25000) 9001485
			(-20000) 8484627
			(-15000) 7924032
			(-10000) 7330058
			(-5000) 6714236
			0 6094794
			5000 5487809
			10000 4903633
			15000 4351584
			20000 3840098
			25000 3373176
			30000 2951047
			35000 2574810
			40000 2242709
			45000 1950136
			50000 1694602
			55000 1472388
			60000 1279594
		>;
	};
};

/*
 * Battery zone: the charger stops at 55 C (driver delta); the vendor
 * kernel resets the board at 60 C (mtktsbattery-sysrst), here a critical
 * trip powers it off.
 */
&thermal_zones {
	battery-thermal {
		polling-delay = <1000>;
		polling-delay-passive = <0>;
		thermal-sensors = <&battery_ntc>;

		trips {
			battery_crit: battery-crit {
				temperature = <60000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};
	};
};

/* Stock dtbo fragment@39: AW9524, i2c3 0x5b; reset in fragment@12.
 * Pin names deliberately await physical LED identification.
 */
&i2c3 {
	clock-frequency = <400000>;
	status = "okay";

	led-controller@5b {
		compatible = "awinic,aw9524-leds";
		reg = <0x5b>;
		reset-gpios = <&pio 109 GPIO_ACTIVE_LOW>;
		#address-cells = <1>;
		#size-cells = <0>;

		led@0 {
			reg = <0>;
			label = "cosmo:aw9524:p0-0";
			max-brightness = <64>;
		};

		led@1 {
			reg = <1>;
			label = "cosmo:aw9524:p0-1";
			max-brightness = <64>;
		};

		led@2 {
			reg = <2>;
			label = "cosmo:aw9524:p0-2";
			max-brightness = <64>;
		};

		led@3 {
			reg = <3>;
			label = "cosmo:aw9524:p0-3";
			max-brightness = <64>;
		};

		led@4 {
			reg = <4>;
			label = "cosmo:aw9524:p0-4";
			max-brightness = <64>;
		};

		led@5 {
			reg = <5>;
			label = "cosmo:aw9524:p0-5";
			max-brightness = <64>;
		};

		led@8 {
			reg = <8>;
			label = "cosmo:aw9524:p1-0";
			max-brightness = <64>;
		};

		led@9 {
			reg = <9>;
			label = "cosmo:aw9524:p1-1";
			max-brightness = <64>;
		};

		led@a {
			reg = <10>;
			label = "cosmo:aw9524:p1-2";
			max-brightness = <64>;
		};

		led@b {
			reg = <11>;
			label = "cosmo:aw9524:p1-3";
			max-brightness = <64>;
		};

		led@c {
			reg = <12>;
			label = "cosmo:aw9524:p1-4";
			max-brightness = <64>;
		};

		led@d {
			reg = <13>;
			label = "cosmo:aw9524:p1-5";
			max-brightness = <64>;
		};
	};
};

/*
 * Own the general PWM controller exclusively for stock PWM1 FIFO.
 * The generic PWM driver only implements old mode. No other consumer
 * uses this controller; display PWM remains disabled separately.
 */
&pwm1 {
	compatible = "planet,cosmo-kbd-backlight";
	/delete-property/ #pwm-cells;
	pinctrl-names = "default";
	pinctrl-0 = <&kbd_pwm_pins>;
	enable-gpios = <&pio 178 GPIO_ACTIVE_HIGH>;
	hdmi-detect-gpios = <&pio 54 GPIO_ACTIVE_HIGH>;
};

&pio {
	kbd_pwm_pins: kbd-pwm-pins {
		pins-pwm {
			pinmux = <PINMUX_GPIO90__FUNC_PWM_A>;
		};
	};
};

&mt6358rtc {
	/* LK and the vendor kernel count the RTC year from 1968 */
	mediatek,rtc-year-base-1968;
};

/*
 * CPU DVFS (docs/cpufreq.md). Stock frequencies (fy5tTbl, CPU level
 * V5_T); each voltage is the higher of stock's base table and the
 * EEM-adjusted value stock ran on this unit (docs/stock-reference.md).
 * Vsram follows Vproc in the MT6358 (bootloader tracking: +100 mV,
 * 0.900-1.11875 V), so only proc-supply is given.
 *
 * Full tables since step C4 (C1-C3 used only the OPPs up to 0.800 V).
 *
 * CCI: mtk-cci-devfreq first moves LK's divider /2 to /1 at the same
 * 598 MHz (kernel/delta/drivers/devfreq/mtk-cci-devfreq.c). Its
 * intermediate clock is clk26m, not mainpll: with the divider at /1,
 * mainpll would run the CCI at 1092 MHz during every change, which stock
 * pairs with 0.894-0.950 V. 26 MHz is below every OPP.
 */
/ {
	cosmo_cl0_opp: opp-table-cosmo-cluster0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-793000000 {
			opp-hz = /bits/ 64 <793000000>;
			opp-microvolt = <600000>;
			required-opps = <&cosmo_cci_273>;
		};
		opp-910000000 {
			opp-hz = /bits/ 64 <910000000>;
			opp-microvolt = <637500>;
			required-opps = <&cosmo_cci_338>;
		};
		opp-1014000000 {
			opp-hz = /bits/ 64 <1014000000>;
			opp-microvolt = <668750>;
			required-opps = <&cosmo_cci_403>;
		};
		opp-1131000000 {
			opp-hz = /bits/ 64 <1131000000>;
			opp-microvolt = <706250>;
			required-opps = <&cosmo_cci_481>;
		};
		opp-1248000000 {
			opp-hz = /bits/ 64 <1248000000>;
			opp-microvolt = <737500>;
			required-opps = <&cosmo_cci_546>;
		};
		opp-1326000000 {
			opp-hz = /bits/ 64 <1326000000>;
			opp-microvolt = <768750>;
			required-opps = <&cosmo_cci_624>;
		};
		opp-1417000000 {
			opp-hz = /bits/ 64 <1417000000>;
			opp-microvolt = <800000>;
			required-opps = <&cosmo_cci_689>;
		};
		opp-1508000000 {
			opp-hz = /bits/ 64 <1508000000>;
			opp-microvolt = <818750>;
			required-opps = <&cosmo_cci_767>;
		};
		opp-1586000000 {
			opp-hz = /bits/ 64 <1586000000>;
			opp-microvolt = <843750>;
			required-opps = <&cosmo_cci_845>;
		};
		opp-1625000000 {
			opp-hz = /bits/ 64 <1625000000>;
			opp-microvolt = <856250>;
			required-opps = <&cosmo_cci_871>;
		};
		opp-1677000000 {
			opp-hz = /bits/ 64 <1677000000>;
			opp-microvolt = <881250>;
			required-opps = <&cosmo_cci_923>;
		};
		opp-1716000000 {
			opp-hz = /bits/ 64 <1716000000>;
			opp-microvolt = <893750>;
			required-opps = <&cosmo_cci_962>;
		};
		opp-1781000000 {
			opp-hz = /bits/ 64 <1781000000>;
			opp-microvolt = <925000>;
			required-opps = <&cosmo_cci_1027>;
		};
		opp-1846000000 {
			opp-hz = /bits/ 64 <1846000000>;
