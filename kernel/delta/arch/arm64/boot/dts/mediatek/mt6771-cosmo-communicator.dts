		cosmo_cci_481: opp-481000000 {
			opp-hz = /bits/ 64 <481000000>;
			opp-microvolt = <706250>;
		};
		cosmo_cci_546: opp-546000000 {
			opp-hz = /bits/ 64 <546000000>;
			opp-microvolt = <737500>;
		};
		cosmo_cci_624: opp-624000000 {
			opp-hz = /bits/ 64 <624000000>;
			opp-microvolt = <768750>;
		};
		cosmo_cci_689: opp-689000000 {
			opp-hz = /bits/ 64 <689000000>;
			opp-microvolt = <800000>;
		};
		cosmo_cci_767: opp-767000000 {
			opp-hz = /bits/ 64 <767000000>;
			opp-microvolt = <818750>;
		};
		cosmo_cci_845: opp-845000000 {
			opp-hz = /bits/ 64 <845000000>;
			opp-microvolt = <843750>;
		};
		cosmo_cci_871: opp-871000000 {
			opp-hz = /bits/ 64 <871000000>;
			opp-microvolt = <856250>;
		};
		cosmo_cci_923: opp-923000000 {
			opp-hz = /bits/ 64 <923000000>;
			opp-microvolt = <881250>;
		};
		cosmo_cci_962: opp-962000000 {
			opp-hz = /bits/ 64 <962000000>;
			opp-microvolt = <893750>;
		};
		cosmo_cci_1027: opp-1027000000 {
			opp-hz = /bits/ 64 <1027000000>;
			opp-microvolt = <925000>;
		};
		cosmo_cci_1092: opp-1092000000 {
			opp-hz = /bits/ 64 <1092000000>;
			opp-microvolt = <950000>;
		};
		cosmo_cci_1144: opp-1144000000 {
			opp-hz = /bits/ 64 <1144000000>;
			opp-microvolt = <975000>;
		};
		cosmo_cci_1196: opp-1196000000 {
			opp-hz = /bits/ 64 <1196000000>;
			opp-microvolt = <1000000>;
		};
	};
};

&cpu0 {
	operating-points-v2 = <&cosmo_cl0_opp>;
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu1 {
	operating-points-v2 = <&cosmo_cl0_opp>;
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu2 {
	operating-points-v2 = <&cosmo_cl0_opp>;
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu3 {
	operating-points-v2 = <&cosmo_cl0_opp>;
	proc-supply = <&mt6358_vproc12_reg>;
};

&cpu4 {
	operating-points-v2 = <&cosmo_cl1_opp>;
	proc-supply = <&mt6358_vproc11_reg>;
};

&cpu5 {
	operating-points-v2 = <&cosmo_cl1_opp>;
	proc-supply = <&mt6358_vproc11_reg>;
};

&cpu6 {
	operating-points-v2 = <&cosmo_cl1_opp>;
	proc-supply = <&mt6358_vproc11_reg>;
};

&cpu7 {
	operating-points-v2 = <&cosmo_cl1_opp>;
	proc-supply = <&mt6358_vproc11_reg>;
};

&cci {
	clocks = <&mcucfg CLK_MCU_BUS_SEL>, <&clk26m>;
	clock-names = "cci", "intermediate";
	operating-points-v2 = <&cosmo_cci_opp>;
	proc-supply = <&mt6358_vproc12_reg>;
};

/*
 * Vproc limits = each table's range (vproc12 = little + CCI), so a wrong
 * request can never leave stock's values for this unit.
 */
&mt6358_vproc11_reg {
	regulator-min-microvolt = <706250>;
	regulator-max-microvolt = <1050000>;
};

&mt6358_vproc12_reg {
	regulator-min-microvolt = <600000>;
	regulator-max-microvolt = <1000000>;
};

/*
 * CPU idle (I1a): core power-down only, as stock's "mcdi" state
 * (cpuidle-mt67xx_acao_v3.c: exit 300 us, residency 4500 us for CPUs
 * 0-3, 1500 us for CPUs 4-7; PSCI 0x00010001 = stock MCDI_CPU). No
 * cluster power-down yet. Needs the SSPM MCDI init that
 * cosmo-cpu-hotplug does at boot (without it a core never wakes, I1a).
 * cosmo,boot-disabled (kernel/delta drivers/cpuidle/dt_idle_states.c)
 * would start a state disabled for per-CPU tests.
 */
&{/cpus/idle-states} {
	COSMO_CPU_OFF_LL: cosmo-cpu-off-ll {
		compatible = "arm,idle-state";
		local-timer-stop;
		arm,psci-suspend-param = <0x00010001>;
		entry-latency-us = <300>;
		exit-latency-us = <300>;
		min-residency-us = <4500>;
	};

	COSMO_CPU_OFF_L: cosmo-cpu-off-l {
		compatible = "arm,idle-state";
		local-timer-stop;
		arm,psci-suspend-param = <0x00010001>;
		entry-latency-us = <300>;
		exit-latency-us = <300>;
		min-residency-us = <1500>;
	};
};

&cpu0 { cpu-idle-states = <&COSMO_CPU_OFF_LL>; };
&cpu1 { cpu-idle-states = <&COSMO_CPU_OFF_LL>; };
&cpu2 { cpu-idle-states = <&COSMO_CPU_OFF_LL>; };
&cpu3 { cpu-idle-states = <&COSMO_CPU_OFF_LL>; };
&cpu4 { cpu-idle-states = <&COSMO_CPU_OFF_L>; };
&cpu5 { cpu-idle-states = <&COSMO_CPU_OFF_L>; };
&cpu6 { cpu-idle-states = <&COSMO_CPU_OFF_L>; };
&cpu7 { cpu-idle-states = <&COSMO_CPU_OFF_L>; };

/*
 * Idle pin levels as stock (live readback of all 180 pins, stock vs this
 * kernel, docs/session-log.md 2026-10-29). Nothing else drives these pins.
 * 101/102: camera resets, stock low. 111: second speaker amp enable,
 * stock output low (was a floating input). 177: stock high, set by the
 * stock Type-C init (usb_typec.c fusb300_init).
 */
&pio {
	cam-rst0-hog {
		gpio-hog;
		gpios = <101 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "cam-rst0-idle";
	};

	cam-rst1-hog {
		gpio-hog;
		gpios = <102 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "cam-rst1-idle";
	};

	extamp2-hog {
		gpio-hog;
		gpios = <111 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "extamp2-idle";
	};

	typec-177-hog {
		gpio-hog;
		gpios = <177 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "typec-177-idle";
	};
};
