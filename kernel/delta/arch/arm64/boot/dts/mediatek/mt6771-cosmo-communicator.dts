// SPDX-License-Identifier: GPL-2.0-only
/*
 * Planet Computers Cosmo Communicator (MediaTek MT6771 / Helio P70)
 *
 * Phase P1 skeleton: CPUs, GIC, timer, UART0, eMMC, PMIC wrapper + MT6358.
 * Built on mt8183.dtsi: the MT6771 shares the MT8183 register map (97/108
 * mt8183.dtsi nodes at identical addresses), pin table (192 pins, 840
 * functions, 0 differences) and PLL offsets. Receipts: docs/hardware-map.md.
 *
 * Board facts are from gemian/cosmo-linux-kernel-4.4 @ a741a2e8:
 *   arch/arm64/boot/dts/mediatek/mt6771.dts      (base, appended by LK)
 *   arch/arm64/boot/dts/mediatek/k71v1_64_bsp.dts (overlay, odmdtbo)
 *   arch/arm64/boot/dts/mediatek/cust_mt6771_msdc.dtsi
 *
 * Deliberately NOT enabled yet: DSI / display pipeline (LK owns the panel;
 * see AGENTS.md panel rule), GPU, CONSYS, audio, MT6370, Type-C.
 *
 * LK contract (docs/p0-findings.md): LK edits this DTB before handoff. It
 * adds its mblock-* carve-outs (ATF, TEE, SSPM, SPM, SCP, modem, the
 * framebuffer) to /reserved-memory itself, so they are NOT declared here:
 * on the Gemini a duplicate no-map reservation of an LK region hung early
 * boot (gemini-nixos mt6797-gemini-pda.dts, 2026-08-31). The vendor nodes
 * LK looks up by path or compatible are carried below, copied from the
 * stock base DTB + dtbo overlay.
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/power/mt8183-power.h>
#include "mt8183.dtsi"
#include "mt6358.dtsi"

/ {
	model = "Planet Computers Cosmo Communicator";
	chassis-type = "handset";
	compatible = "planet,cosmo-communicator", "mediatek,mt6771",
		     "mediatek,mt8183";

	aliases {
		serial0 = &uart0;
		mmc0 = &mmc0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* vendor: console=ttyS0,921600n1 (mt6771.dts chosen) */
		stdout-path = "serial0:921600n8";

		/*
		 * LK's framebuffer, scanned out by LK's display path (no DSI
		 * touch: panel rule). Measured on Gemian 4.4, 2026-10-25: base
		 * 0x7df70000 (also the LK log's fb_base, and LK reserves
		 * 0x7df70000 +0x1f90000 no-map as mblock-7-framebuffer), 1080x2160,
		 * stride 4352 (1088 px), 32 bpp R/G/B/A at bit 0/8/16/24.
		 * reg = one buffer (4352 * 2160).
		 */
		framebuffer@7df70000 {
			compatible = "simple-framebuffer";
			reg = <0 0x7df70000 0 0x8f7000>;
			width = <1080>;
			height = <2160>;
			stride = <4352>;
			format = "a8b8g8r8";
			/* keep the display power domain on while simpledrm owns it */
			power-domains = <&spm MT8183_POWER_DOMAIN_DISP>;
		};
	};

	/*
	 * 6 GiB at 0x40000000 (Gemian 4.4 /sys/firmware/fdt, 2026-10-25). LK
	 * looks this node up by the exact path /memory and rewrites it ("DTS:
	 * /memory node is not found create new memory node", and while(1) on
	 * failure, in LK strings), so it is named "memory" like the vendor
	 * node, not memory@40000000 (dtc W=1 warns about that; intended).
	 */
	memory {
		device_type = "memory";
		reg = <0 0x40000000 1 0x80000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * Fixed LK/preloader regions copied from vendor mt6771.dts.
		 * Kept no-map so the kernel never scribbles on them. ATF/TEE/
		 * SSPM regions are expected to be added by LK's fdt fixups at
		 * boot — TODO(P0): confirm from a dump of /proc/device-tree.
		 */
		ram_console@54400000 {
			reg = <0 0x54400000 0 0x10000>;
			no-map;
		};

		/*
		 * ramoops in the vendor pstore region, same layout as Gemian 4.4
		 * (dmesg: console_size 0x40000, pmsg_size 0x10000; record and
		 * ftrace at the 4.4 defaults of 4 KiB). The other kernel can then
		 * read this kernel's console log after a reboot.
		 */
		ramoops@54410000 {
			compatible = "ramoops";
			reg = <0 0x54410000 0 0xe0000>;
			record-size = <0x1000>;
			console-size = <0x40000>;
			ftrace-size = <0x1000>;
			pmsg-size = <0x10000>;
		};

		minirdump@544f0000 {
			reg = <0 0x544f0000 0 0x10000>;
			no-map;
		};

		/*
		 * Required by mt8183.dtsi's &scp, and LK looks it up by the
		 * vendor name/compatible: one pool for both. Sized exactly as
		 * vendor reserve-memory-scp_share (20 MiB, 16 MiB aligned).
		 * SCP itself stays disabled until P2.
		 */
		scp_mem_reserved: reserve-memory-scp_share {
			compatible = "shared-dma-pool",
				     "mediatek,reserve-memory-scp_share";
			size = <0 0x1400000>;
			alignment = <0 0x1000000>;
			alloc-ranges = <0 0x40000000 0 0x50000000>;
			no-map;
		};

		/* LK reads /reserved-memory/reserve-memory-sspm_share (LK strings); vendor node verbatim */
		reserve-memory-sspm_share {
			compatible = "mediatek,reserve-memory-sspm_share";
			no-map;
			size = <0 0x510000>;
			alignment = <0 0x10000>;
			alloc-ranges = <0 0x40000000 0 0x60000000>;
		};
	};

	/*
	 * Vendor nodes LK reads before handoff, verbatim from the stock base
	 * DTB + dtbo overlay (fdtoverlay, 2026-10-25); phandles dropped. No
	 * mainline driver matches these compatibles; status disabled keeps
	 * Linux from creating devices for them.
	 *  - /gpio@10005000: LK applies gpio_init_default (stock pin setup)
	 *    by path ("[GPIO] Found /gpio@10005000" in the LK log).
	 *  - mediatek,scp: LK's platform_fdt_scp() ("[SCP] mediatek,scp not
	 *    found!"); on the Gemini a missing scp node asserted in LK.
	 *  - mediatek,lk_charger: LK charger limits.
	 */
	gpio@10005000 {
		gpio_init_default = <0x00 0x07 0x01 0x00 0x00 0x00 0x01 0x01 0x07 0x01 0x00 0x01 0x00 0x01 0x02 0x07 0x01 0x00 0x00 0x00 0x01 0x03 0x00 0x00 0x00 0x01 0x01 0x01 0x04 0x00 0x00 0x00 0x01 0x01 0x00 0x05 0x00 0x00 0x00 0x01 0x00 0x00 0x06 0x00 0x00 0x00 0x01 0x01 0x00 0x07 0x00 0x00 0x00 0x01 0x00 0x00 0x08 0x00 0x00 0x00 0x01 0x01 0x00 0x09 0x00 0x00 0x00 0x01 0x01 0x00 0x0a 0x00 0x00 0x00 0x01 0x01 0x00 0x0b 0x00 0x00 0x00 0x01 0x01 0x00 0x0c 0x00 0x00 0x00 0x01 0x01 0x00 0x0d 0x01 0x01 0x00 0x00 0x00 0x00 0x0e 0x01 0x01 0x00 0x00 0x00 0x00 0x0f 0x01 0x01 0x00 0x00 0x00 0x00 0x10 0x01 0x01 0x00 0x00 0x00 0x00 0x11 0x01 0x01 0x00 0x00 0x00 0x00 0x12 0x01 0x01 0x00 0x00 0x00 0x00 0x13 0x01 0x01 0x00 0x00 0x00 0x00 0x14 0x01 0x01 0x00 0x00 0x00 0x00 0x15 0x01 0x01 0x00 0x00 0x00 0x00 0x16 0x01 0x01 0x00 0x00 0x00 0x00 0x17 0x01 0x01 0x00 0x00 0x00 0x00 0x18 0x01 0x01 0x00 0x00 0x00 0x00 0x19 0x01 0x01 0x00 0x00 0x00 0x00 0x1a 0x01 0x01 0x00 0x00 0x00 0x00 0x1b 0x01 0x01 0x00 0x00 0x00 0x00 0x1c 0x01 0x01 0x00 0x00 0x00 0x00 0x1d 0x01 0x01 0x00 0x00 0x00 0x00 0x1e 0x01 0x00 0x00 0x01 0x01 0x00 0x1f 0x01 0x00 0x00 0x01 0x01 0x00 0x20 0x01 0x00 0x00 0x01 0x01 0x00 0x21 0x01 0x00 0x00 0x01 0x01 0x00 0x22 0x01 0x00 0x00 0x01 0x01 0x00 0x23 0x01 0x00 0x00 0x01 0x01 0x00 0x24 0x01 0x01 0x00 0x00 0x00 0x00 0x25 0x01 0x01 0x00 0x00 0x00 0x00 0x26 0x01 0x01 0x00 0x00 0x00 0x00 0x27 0x01 0x01 0x00 0x00 0x00 0x00 0x28 0x01 0x00 0x00 0x01 0x01 0x00 0x29 0x00 0x00 0x00 0x01 0x01 0x00 0x2a 0x00 0x01 0x00 0x00 0x00 0x00 0x2b 0x01 0x01 0x00 0x00 0x00 0x00 0x2c 0x01 0x00 0x00 0x01 0x00 0x00 0x2d 0x01 0x01 0x01 0x00 0x00 0x00 0x2e 0x00 0x00 0x00 0x01 0x00 0x00 0x2f 0x01 0x00 0x00 0x01 0x01 0x00 0x30 0x01 0x00 0x00 0x01 0x01 0x00 0x31 0x01 0x00 0x00 0x01 0x01 0x00 0x32 0x01 0x00 0x00 0x01 0x01 0x00 0x33 0x01 0x00 0x00 0x01 0x01 0x00 0x34 0x00 0x01 0x00 0x01 0x00 0x00 0x35 0x00 0x01 0x00 0x01 0x00 0x00 0x36 0x00 0x00 0x00 0x01 0x00 0x00 0x37 0x01 0x01 0x00 0x01 0x00 0x00 0x38 0x01 0x01 0x00 0x01 0x00 0x00 0x39 0x01 0x01 0x00 0x01 0x00 0x00 0x3a 0x00 0x00 0x00 0x01 0x00 0x00 0x3b 0x01 0x00 0x00 0x01 0x00 0x00 0x3c 0x01 0x00 0x00 0x01 0x00 0x00 0x3d 0x01 0x00 0x00 0x01 0x00 0x00 0x3e 0x01 0x00 0x00 0x01 0x00 0x00 0x3f 0x01 0x00 0x00 0x01 0x00 0x00 0x40 0x01 0x00 0x00 0x01 0x00 0x00 0x41 0x00 0x00 0x00 0x01 0x00 0x00 0x42 0x00 0x00 0x00 0x01 0x00 0x00 0x43 0x01 0x00 0x00 0x01 0x00 0x00 0x44 0x01 0x00 0x00 0x01 0x00 0x00 0x45 0x00 0x00 0x00 0x01 0x00 0x00 0x46 0x00 0x01 0x00 0x01 0x00 0x00 0x47 0x00 0x00 0x00 0x01 0x00 0x00 0x48 0x00 0x01 0x00 0x01 0x00 0x00 0x49 0x00 0x01 0x00 0x01 0x00 0x00 0x4a 0x00 0x01 0x00 0x01 0x00 0x00 0x4b 0x00 0x01 0x00 0x01 0x00 0x00 0x4c 0x00 0x01 0x01 0x01 0x00 0x00 0x4d 0x00 0x01 0x00 0x01 0x00 0x00 0x4e 0x00 0x00 0x00 0x01 0x01 0x00 0x4f 0x00 0x00 0x00 0x01 0x00 0x00 0x50 0x00 0x00 0x00 0x01 0x00 0x00 0x51 0x01 0x00 0x00 0x01 0x01 0x00 0x52 0x01 0x00 0x00 0x01 0x01 0x00 0x53 0x01 0x00 0x00 0x01 0x01 0x00 0x54 0x01 0x00 0x00 0x01 0x01 0x00 0x55 0x01 0x01 0x00 0x00 0x00 0x00 0x56 0x01 0x00 0x00 0x01 0x00 0x00 0x57 0x01 0x00 0x00 0x01 0x00 0x00 0x58 0x01 0x00 0x00 0x01 0x00 0x00 0x59 0x01 0x00 0x00 0x01 0x00 0x00 0x5a 0x01 0x01 0x00 0x00 0x00 0x00 0x5b 0x00 0x01 0x00 0x00 0x00 0x00 0x5c 0x00 0x01 0x00 0x00 0x00 0x00 0x5d 0x00 0x01 0x00 0x01 0x01 0x00 0x5e 0x07 0x00 0x00 0x01 0x00 0x00 0x5f 0x01 0x01 0x00 0x00 0x00 0x00 0x60 0x01 0x01 0x00 0x00 0x00 0x00 0x61 0x00 0x01 0x00 0x00 0x00 0x00 0x62 0x00 0x01 0x00 0x00 0x00 0x00 0x63 0x00 0x01 0x00 0x00 0x00 0x00 0x64 0x00 0x01 0x00 0x00 0x00 0x00 0x65 0x00 0x01 0x01 0x00 0x00 0x00 0x66 0x00 0x01 0x01 0x00 0x00 0x00 0x67 0x01 0x00 0x00 0x01 0x01 0x00 0x68 0x01 0x00 0x00 0x01 0x01 0x00 0x69 0x01 0x00 0x00 0x01 0x01 0x00 0x6a 0x01 0x00 0x00 0x01 0x01 0x00 0x6b 0x00 0x01 0x01 0x00 0x00 0x00 0x6c 0x00 0x01 0x00 0x00 0x00 0x00 0x6d 0x00 0x01 0x00 0x00 0x00 0x00 0x6e 0x07 0x00 0x00 0x01 0x01 0x00 0x6f 0x00 0x00 0x00 0x00 0x00 0x01 0x70 0x07 0x01 0x00 0x00 0x00 0x00 0x71 0x01 0x00 0x00 0x01 0x00 0x00 0x72 0x01 0x00 0x00 0x01 0x00 0x00 0x73 0x01 0x00 0x00 0x01 0x00 0x00 0x74 0x01 0x00 0x00 0x01 0x00 0x00 0x75 0x01 0x00 0x00 0x01 0x00 0x00 0x76 0x01 0x00 0x00 0x01 0x00 0x00 0x77 0x01 0x00 0x00 0x01 0x00 0x00 0x78 0x01 0x00 0x00 0x01 0x00 0x00 0x79 0x01 0x00 0x00 0x01 0x00 0x00 0x7a 0x01 0x00 0x00 0x01 0x01 0x00 0x7b 0x01 0x00 0x00 0x01 0x01 0x00 0x7c 0x01 0x01 0x00 0x00 0x00 0x00 0x7d 0x01 0x00 0x00 0x01 0x01 0x00 0x7e 0x01 0x00 0x00 0x01 0x01 0x00 0x7f 0x01 0x00 0x00 0x01 0x01 0x00 0x80 0x01 0x00 0x00 0x01 0x01 0x00 0x81 0x01 0x00 0x00 0x01 0x01 0x00 0x82 0x01 0x00 0x00 0x01 0x01 0x00 0x83 0x01 0x00 0x00 0x01 0x00 0x00 0x84 0x01 0x00 0x00 0x01 0x01 0x00 0x85 0x01 0x01 0x01 0x00 0x00 0x00 0x86 0x01 0x00 0x00 0x01 0x00 0x01 0x87 0x01 0x01 0x00 0x00 0x00 0x00 0x88 0x01 0x01 0x00 0x01 0x00 0x00 0x89 0x01 0x01 0x00 0x01 0x00 0x00 0x8a 0x01 0x01 0x00 0x00 0x00 0x00 0x8b 0x01 0x01 0x00 0x01 0x00 0x00 0x8c 0x01 0x00 0x00 0x00 0x00 0x00 0x8d 0x01 0x00 0x00 0x00 0x00 0x00 0x8e 0x01 0x00 0x00 0x00 0x00 0x00 0x8f 0x01 0x00 0x00 0x00 0x00 0x00 0x90 0x01 0x00 0x00 0x01 0x00 0x00 0x91 0x01 0x01 0x01 0x00 0x00 0x00 0x92 0x01 0x00 0x00 0x01 0x00 0x00 0x93 0x01 0x01 0x00 0x00 0x00 0x00 0x94 0x01 0x01 0x00 0x00 0x00 0x00 0x95 0x01 0x01 0x00 0x00 0x00 0x00 0x96 0x00 0x01 0x00 0x00 0x00 0x00 0x97 0x00 0x01 0x00 0x00 0x00 0x00 0x98 0x00 0x01 0x00 0x00 0x00 0x00 0x99 0x00 0x01 0x00 0x00 0x00 0x00 0x9a 0x01 0x01 0x00 0x00 0x00 0x00 0x9b 0x01 0x00 0x00 0x01 0x00 0x00 0x9c 0x00 0x01 0x01 0x01 0x00 0x00 0x9d 0x00 0x00 0x00 0x01 0x00 0x00 0x9e 0x00 0x01 0x01 0x00 0x00 0x00 0x9f 0x00 0x01 0x00 0x00 0x00 0x00 0xa0 0x00 0x01 0x01 0x01 0x01 0x00 0xa1 0x02 0x00 0x00 0x00 0x00 0x00 0xa2 0x02 0x01 0x00 0x00 0x00 0x00 0xa3 0x02 0x01 0x00 0x00 0x00 0x00 0xa4 0x02 0x01 0x00 0x00 0x00 0x00 0xa5 0x02 0x01 0x00 0x00 0x00 0x00 0xa6 0x00 0x00 0x00 0x01 0x01 0x00 0xa7 0x01 0x01 0x00 0x01 0x00 0x00 0xa8 0x01 0x01 0x00 0x01 0x00 0x00 0xa9 0x02 0x01 0x00 0x00 0x00 0x00 0xaa 0x02 0x01 0x00 0x00 0x00 0x00 0xab 0x02 0x01 0x00 0x00 0x00 0x00 0xac 0x02 0x01 0x00 0x00 0x00 0x00 0xad 0x02 0x01 0x00 0x00 0x00 0x00 0xae 0x02 0x01 0x00 0x00 0x00 0x00 0xaf 0x00 0x01 0x00 0x00 0x00 0x00 0xb0 0x00 0x01 0x00 0x00 0x00 0x00 0xb1 0x00 0x01 0x00 0x00 0x00 0x00 0xb2 0x00 0x00 0x00 0x01 0x00 0x00 0xb3 0x00 0x00 0x00 0x01 0x00 0x00 0xb4 0x00 0x00 0x00 0x01 0x00 0x00 0xb5 0x00 0x00 0x00 0x01 0x00 0x00 0xb6 0x00 0x00 0x00 0x01 0x00 0x00 0xb7 0x00 0x00 0x00 0x01 0x00 0x00 0xb8 0x00 0x00 0x00 0x01 0x00 0x00 0xb9 0x00 0x00 0x00 0x01 0x00 0x00 0xba 0x00 0x00 0x00 0x01 0x00 0x00 0xbb 0x00 0x00 0x00 0x01 0x00 0x00 0xbc 0x00 0x00 0x00 0x01 0x00 0x00 0xbd 0x00 0x00 0x00 0x01 0x00 0x00 0xbe 0x00 0x00 0x00 0x01 0x00 0x00 0xbf 0x00 0x00 0x00 0x01 0x00 0x00>;
		compatible = "mediatek,gpio";
		reg = <0x00 0x10005000 0x00 0x1000>;
		status = "disabled";
	};

	scp@10500000 {
		scp_sramSize = <0x80000>;
		core_1 = "enable";
		compatible = "mediatek,scp";
		status = "disabled";
		reg = <0x00 0x10500000 0x00 0x80000 0x00 0x105c0000 0x00 0x3000 0x00 0x105c4000 0x00 0x1000 0x00 0x105d4000 0x00 0x6000>;
		interrupts = <0x00 0xae 0x04>;
	};

	lk-charger {
		compatible = "mediatek,lk_charger";
		enable_pe_plus;
		power_path_support;
		max_charger_voltage = <0x632ea0>;
		fast_charge_voltage = <0x2dc6c0>;
		usb_charger_current = <0x7a120>;
		ac_charger_current = <0x1f47d0>;
		ac_charger_input_current = <0x30d400>;
		non_std_ac_charger_current = <0x1f47d0>;
		charging_host_charger_current = <0x16e360>;
		ta_ac_charger_current = <0x2dc6c0>;
		pd_charger_current = <0x7a120>;
		temp_t4_threshold = <0x32>;
		temp_t3_threshold = <0x2d>;
		temp_t1_threshold = <0x00>;
	};
};

&mmc0 {
	/* vendor cust_mt6771_msdc.dtsi: 8-bit, 200 MHz, HS200/HS400 1.8 V, VEMC */
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	bus-width = <8>;
	/*
	 * Start at HS200 only; HS400 (and its ds-delay tuning) comes in P2
	 * once the basic path is proven on glass.
	 */
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	cap-mmc-hw-reset;
	no-sdio;
	no-sd;
	vmmc-supply = <&mt6358_vemc_reg>;
	vqmmc-supply = <&mt6358_vio18_reg>;
	assigned-clocks = <&topckgen CLK_TOP_MUX_MSDC50_0>;
	assigned-clock-parents = <&topckgen CLK_TOP_MSDCPLL_CK>;
	non-removable;
};

&pio {
	/* MSDC0 pins are fixed on the die; identical to mt8183-kukui.dtsi */
	mmc0_pins_default: mmc0-default-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO123__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO128__FUNC_MSDC0_DAT1>,
				 <PINMUX_GPIO125__FUNC_MSDC0_DAT2>,
				 <PINMUX_GPIO132__FUNC_MSDC0_DAT3>,
				 <PINMUX_GPIO126__FUNC_MSDC0_DAT4>,
				 <PINMUX_GPIO129__FUNC_MSDC0_DAT5>,
				 <PINMUX_GPIO127__FUNC_MSDC0_DAT6>,
				 <PINMUX_GPIO130__FUNC_MSDC0_DAT7>,
				 <PINMUX_GPIO122__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-up-adv = <01>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO124__FUNC_MSDC0_CLK>;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-down-adv = <2>;
		};

		pins-rst {
			pinmux = <PINMUX_GPIO133__FUNC_MSDC0_RSTB>;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-down-adv = <01>;
		};
	};

	mmc0_pins_uhs: mmc0-uhs-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO123__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO128__FUNC_MSDC0_DAT1>,
				 <PINMUX_GPIO125__FUNC_MSDC0_DAT2>,
				 <PINMUX_GPIO132__FUNC_MSDC0_DAT3>,
				 <PINMUX_GPIO126__FUNC_MSDC0_DAT4>,
				 <PINMUX_GPIO129__FUNC_MSDC0_DAT5>,
				 <PINMUX_GPIO127__FUNC_MSDC0_DAT6>,
				 <PINMUX_GPIO130__FUNC_MSDC0_DAT7>,
				 <PINMUX_GPIO122__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-up-adv = <01>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO124__FUNC_MSDC0_CLK>;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-down-adv = <2>;
		};

		pins-ds {
			pinmux = <PINMUX_GPIO131__FUNC_MSDC0_DSL>;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-down-adv = <2>;
		};

		pins-rst {
			pinmux = <PINMUX_GPIO133__FUNC_MSDC0_RSTB>;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-down-adv = <01>;
		};
	};

	/* vendor k71v1_64_bsp.dts &apuart0: RX GPIO95, TX GPIO96 */
	uart0_pins_default: uart0-pins {
		pins-rx {
			pinmux = <PINMUX_GPIO95__FUNC_URXD0>;
			input-enable;
			bias-pull-up;
		};

		pins-tx {
			pinmux = <PINMUX_GPIO96__FUNC_UTXD0>;
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins_default>;
	status = "okay";
};

/*
 * First boots: the M4U and SMI sit in the display's memory path and have
 * no consumers yet (DRM_MEDIATEK is a module and not loaded). Keep them
 * out of the way of LK's running scanout.
 */
&iommu {
	status = "disabled";
};

&smi_common {
	status = "disabled";
};

&larb0 {
	status = "disabled";
};

&larb1 {
	status = "disabled";
};

&larb2 {
	status = "disabled";
};

&larb3 {
	status = "disabled";
};

&larb4 {
	status = "disabled";
};

&larb5 {
	status = "disabled";
};

&larb6 {
	status = "disabled";
};
