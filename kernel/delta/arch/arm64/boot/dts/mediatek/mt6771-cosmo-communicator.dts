// SPDX-License-Identifier: GPL-2.0-only
/*
 * Planet Computers Cosmo Communicator (MediaTek MT6771 / Helio P70)
 *
 * Phase P1 skeleton: CPUs, GIC, timer, UART0, eMMC, PMIC wrapper + MT6358.
 * Built on mt8183.dtsi: the MT6771 shares the MT8183 register map (97/108
 * mt8183.dtsi nodes at identical addresses), pin table (192 pins, 840
 * functions, 0 differences) and PLL offsets. Receipts: docs/hardware-map.md.
 *
 * Board facts are from gemian/cosmo-linux-kernel-4.4 @ a741a2e8:
 *   arch/arm64/boot/dts/mediatek/mt6771.dts      (base, appended by LK)
 *   arch/arm64/boot/dts/mediatek/k71v1_64_bsp.dts (overlay, odmdtbo)
 *   arch/arm64/boot/dts/mediatek/cust_mt6771_msdc.dtsi
 *
 * Deliberately NOT enabled yet: DSI / display pipeline (LK owns the panel;
 * see AGENTS.md panel rule), GPU, CONSYS, audio, MT6370, Type-C.
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "mt8183.dtsi"
#include "mt6358.dtsi"

/ {
	model = "Planet Computers Cosmo Communicator";
	chassis-type = "handset";
	compatible = "planet,cosmo-communicator", "mediatek,mt6771",
		     "mediatek,mt8183";

	aliases {
		serial0 = &uart0;
		mmc0 = &mmc0;
	};

	chosen {
		/* vendor: console=ttyS0,921600n1 (mt6771.dts chosen) */
		stdout-path = "serial0:921600n8";
	};

	/*
	 * 6 GiB at 0x40000000 per spec; LK rewrites /memory at boot (vendor
	 * mt6771.dts carries only a placeholder: <0 0x40000000 0 0x1e605000>).
	 * TODO(P0): confirm against /proc/iomem from Gemian 4.4.
	 */
	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 1 0x80000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * Fixed LK/preloader regions copied from vendor mt6771.dts.
		 * Kept no-map so the kernel never scribbles on them. ATF/TEE/
		 * SSPM regions are expected to be added by LK's fdt fixups at
		 * boot — TODO(P0): confirm from a dump of /proc/device-tree.
		 */
		ram_console@54400000 {
			reg = <0 0x54400000 0 0x10000>;
			no-map;
		};

		pstore@54410000 {
			reg = <0 0x54410000 0 0xe0000>;
			no-map;
		};

		minirdump@544f0000 {
			reg = <0 0x544f0000 0 0x10000>;
			no-map;
		};

		/*
		 * Required by mt8183.dtsi's &scp. Sized exactly as vendor
		 * reserve-memory-scp_share (20 MiB, 16 MiB aligned, below
		 * 0x90000000). SCP itself stays disabled until P2.
		 */
		scp_mem_reserved: scp-mem {
			compatible = "shared-dma-pool";
			size = <0 0x1400000>;
			alignment = <0 0x1000000>;
			alloc-ranges = <0 0x40000000 0 0x50000000>;
			no-map;
		};
	};
};

&mmc0 {
	/* vendor cust_mt6771_msdc.dtsi: 8-bit, 200 MHz, HS200/HS400 1.8 V, VEMC */
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	bus-width = <8>;
	/*
	 * Start at HS200 only; HS400 (and its ds-delay tuning) comes in P2
	 * once the basic path is proven on glass.
	 */
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	cap-mmc-hw-reset;
	no-sdio;
	no-sd;
	vmmc-supply = <&mt6358_vemc_reg>;
	vqmmc-supply = <&mt6358_vio18_reg>;
	assigned-clocks = <&topckgen CLK_TOP_MUX_MSDC50_0>;
	assigned-clock-parents = <&topckgen CLK_TOP_MSDCPLL_CK>;
	non-removable;
};

&pio {
	/* MSDC0 pins are fixed on the die; identical to mt8183-kukui.dtsi */
	mmc0_pins_default: mmc0-default-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO123__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO128__FUNC_MSDC0_DAT1>,
				 <PINMUX_GPIO125__FUNC_MSDC0_DAT2>,
				 <PINMUX_GPIO132__FUNC_MSDC0_DAT3>,
				 <PINMUX_GPIO126__FUNC_MSDC0_DAT4>,
				 <PINMUX_GPIO129__FUNC_MSDC0_DAT5>,
				 <PINMUX_GPIO127__FUNC_MSDC0_DAT6>,
				 <PINMUX_GPIO130__FUNC_MSDC0_DAT7>,
				 <PINMUX_GPIO122__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-up-adv = <01>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO124__FUNC_MSDC0_CLK>;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-down-adv = <2>;
		};

		pins-rst {
			pinmux = <PINMUX_GPIO133__FUNC_MSDC0_RSTB>;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-down-adv = <01>;
		};
	};

	mmc0_pins_uhs: mmc0-uhs-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO123__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO128__FUNC_MSDC0_DAT1>,
				 <PINMUX_GPIO125__FUNC_MSDC0_DAT2>,
				 <PINMUX_GPIO132__FUNC_MSDC0_DAT3>,
				 <PINMUX_GPIO126__FUNC_MSDC0_DAT4>,
				 <PINMUX_GPIO129__FUNC_MSDC0_DAT5>,
				 <PINMUX_GPIO127__FUNC_MSDC0_DAT6>,
				 <PINMUX_GPIO130__FUNC_MSDC0_DAT7>,
				 <PINMUX_GPIO122__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-up-adv = <01>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO124__FUNC_MSDC0_CLK>;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-down-adv = <2>;
		};

		pins-ds {
			pinmux = <PINMUX_GPIO131__FUNC_MSDC0_DSL>;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-down-adv = <2>;
		};

		pins-rst {
			pinmux = <PINMUX_GPIO133__FUNC_MSDC0_RSTB>;
			drive-strength = <MTK_DRIVE_14mA>;
			mediatek,pull-down-adv = <01>;
		};
	};

	/* vendor k71v1_64_bsp.dts &apuart0: RX GPIO95, TX GPIO96 */
	uart0_pins_default: uart0-pins {
		pins-rx {
			pinmux = <PINMUX_GPIO95__FUNC_URXD0>;
			input-enable;
			bias-pull-up;
		};

		pins-tx {
			pinmux = <PINMUX_GPIO96__FUNC_UTXD0>;
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins_default>;
	status = "okay";
};
