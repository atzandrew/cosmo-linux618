# Stock MediaTek WMT core (wmt_drv) for the on-die MT6771 CONSYS.
# Flags and objects follow the stock 4.4 build for CONSYS_6771 (Makefile.vendor).
ccflags-y += -D CONFIG_MTK_WCN_ARM64 -D WMT_IDC_SUPPORT=0 -D MTK_WCN_WMT_STP_EXP_SYMBOL_ABSTRACT
ccflags-y += -D MTK_WCN_SOC_CHIP_SUPPORT -D MTK_WCN_WLAN_GEN3
ccflags-y += -D WMT_PLAT_ALPS=1 -D WMT_UART_RX_MODE_WORK=0 -D WMT_SDIO_MODE=1 -D WMT_CREATE_NODE_DYNAMIC=1
ccflags-y += -D WMT_DBG_SUPPORT=1 -D CFG_WMT_STEP
ccflags-y += -include $(src)/../include/wcn_compat.h
ccflags-y += -I$(src) -I$(src)/common_main/linux/include -I$(src)/common_main/linux/pri/include
ccflags-y += -I$(src)/common_main/platform/include -I$(src)/common_main/core/include
ccflags-y += -I$(src)/common_main/include -I$(src)/common_detect/drv_init/inc -I$(src)/common_detect
ccflags-y += -I$(src)/debug_utility -I$(src)/../btif/inc
wmt_drv-objs := common_detect/wmt_detect_pwr.o common_detect/wmt_detect.o common_detect/mtk_wcn_stub_alps.o \
 common_detect/wmt_gpio.o common_detect/sdio_detect.o \
 common_detect/drv_init/conn_drv_init.o common_detect/drv_init/bluetooth_drv_init.o \
 common_detect/drv_init/wlan_drv_init.o common_detect/drv_init/common_drv_init.o \
 common_detect/drv_init/gps_drv_init.o common_detect/drv_init/fm_drv_init.o \
 common_main/platform/mt6771.o common_main/platform/wmt_plat_alps.o \
 common_main/platform/mtk_wcn_consys_hw.o common_main/platform/mtk_wcn_cmb_hw.o \
 common_main/core/wmt_ic_6628.o common_main/core/wmt_conf.o common_main/core/stp_core.o \
 common_main/core/wmt_ctrl.o common_main/core/wmt_func.o common_main/core/wmt_core.o \
 common_main/core/psm_core.o common_main/core/wmt_ic_soc.o common_main/core/wmt_lib.o \
 common_main/core/wmt_ic_6620.o common_main/core/stp_exp.o common_main/core/wmt_ic_6632.o \
 common_main/core/wmt_exp.o common_main/core/btm_core.o common_main/core/wmt_ic_6630.o \
 common_main/linux/stp_dbg_soc.o common_main/linux/stp_dbg_combo.o common_main/linux/osal.o \
 common_main/linux/wmt_dev.o common_main/linux/bgw_desense.o common_main/linux/wmt_dbg.o \
 common_main/linux/stp_dbg.o common_main/linux/wmt_step.o common_main/linux/stp_btif.o common_main/linux/hif_sdio.o common_main/linux/stp_sdio.o wcn_adapter.o wmt_build_in_adapter.o wcn_launcher.o \
 debug_utility/ring.o debug_utility/ring_emi.o debug_utility/connsys_debug_utility.o
ccflags-y += -I$(src)/../include -I$(srctree)/drivers/mmc/core
obj-$(CONFIG_MTK_WCN_CONSYS) += wmt_drv.o
