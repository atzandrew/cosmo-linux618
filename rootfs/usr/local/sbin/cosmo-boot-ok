#!/bin/sh
# Tell the Cosmo initramfs that this root system came up: once systemd has
# reached multi-user.target (normal start-up finished), overwrite the
# tripwire flag (8 MiB into the raw `cache` partition) with COSMO-OK.
# Nothing here depends on SSH or the network. If start-up never gets that
# far (emergency mode, a hang), the flag stays COSMO-TRY and the next boot
# goes to the rescue initramfs.
set -e
dev=/dev/disk/by-partlabel/cache
[ -b "$dev" ] || { echo "cosmo-boot-ok: no $dev" >&2; exit 1; }
systemctl is-active --quiet multi-user.target \
    || { echo "cosmo-boot-ok: multi-user.target not reached: boot NOT confirmed" >&2; exit 1; }
printf 'COSMO-OK\0' | dd of="$dev" bs=512 seek=16384 count=1 conv=sync,notrunc status=none
sync
echo "cosmo-boot-ok: multi-user.target reached, boot confirmed"
