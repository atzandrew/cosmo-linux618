#!/bin/sh
# Esc/power key (the PMIC power key, reported as KEY_ESC by the DT): a tap is
# a normal Esc for every program; hold 4 s = clean power off. logind ignores
# power keys (logind.conf.d/cosmo-power-key.conf). The PMIC's ~8 s hold reset
# is separate hardware and still works if Linux is hung.
HOLD=4
dev=
for n in /sys/class/input/event*/device/name; do
    [ "$(cat "$n" 2>/dev/null)" = "mtk-pmic-keys" ] || continue
    dev=/dev/input/$(basename "$(dirname "$(dirname "$n")")")
    break
done
[ -n "$dev" ] || { echo "cosmo-power-key: no mtk-pmic-keys input device" >&2; exit 0; }
echo "cosmo-power-key: watching $dev (hold Esc ${HOLD} s = power off)"
timer=
# struct input_event on arm64 = 24 bytes: 16 time, u16 type, u16 code,
# s32 value. As 12 u16 words: $9 = type, $10 = code, $11 = value (low).
# KEY_ESC = 1. Autorepeat (value 2) is ignored.
stdbuf -o0 od -An -v -tu2 -w24 "$dev" | while read -r _ _ _ _ _ _ _ _ type code val _; do
    [ "$type" = 1 ] && [ "$code" = 1 ] || continue
    if [ "$val" = 1 ]; then
        [ -n "$timer" ] && kill "$timer" 2>/dev/null
        ( sleep "$HOLD"; echo "cosmo-power-key: Esc held ${HOLD} s, powering off"; systemctl poweroff ) &
        timer=$!
    elif [ "$val" = 0 ] && [ -n "$timer" ]; then
        kill "$timer" 2>/dev/null
        timer=
    fi
done
