#!/bin/busybox sh
# Cosmo bring-up initramfs (P1): prove the kernel is alive, on glass and in
# pstore. No root switch, no writes to the eMMC.
/bin/busybox --install -s /bin
export PATH=/bin
mkdir -p /proc /sys /dev /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null

# The console the kernel picked may be the unreachable UART; write to the
# framebuffer console and the kernel log (-> ramoops) explicitly.
say() { echo "$*" > /dev/tty0 2>/dev/null; echo "cosmo-init: $*" > /dev/kmsg 2>/dev/null; }

say "===== Cosmo mainline bring-up: initramfs reached ====="

# Bring-up life signal that needs neither the display nor the firmware's
# PSCI reset: open the SoC watchdog and never feed it. mtk_wdt resets the
# board ~31 s later; a reset within ~45 s of the orange screen proves this
# init ran (2026-10-25).
for w in /dev/watchdog0 /dev/watchdog; do
	if [ -e $w ]; then
		echo x > $w 2>/dev/null && { say "watchdog $w armed, not fed: reset in ~31 s"; break; }
	fi
done
say "$(uname -a)"
say "cmdline: $(cat /proc/cmdline)"
say "cpus online: $(cat /sys/devices/system/cpu/online)"
say "mem: $(grep -E 'MemTotal' /proc/meminfo)"
say "drm: $(ls /sys/class/drm 2>/dev/null | tr '\n' ' ')"
say "mmc: $(ls /sys/class/block 2>/dev/null | grep -c mmcblk0p) eMMC partitions seen"
say "deferred: $(cat /sys/kernel/debug/devices_deferred 2>/dev/null | wc -l) (debugfs may be absent)"
dmesg | grep -iE 'error|fail|unable|deferred' | tail -n 25 > /dev/tty0 2>/dev/null

# Layer test: LK leaves two OVL layers on (layer 0 = fb at 0x7df70000,
# layer 3 = DAL at 0x7e878000, on top). fbcon draws into the first. Fill
# rows 1400-2100 of every other framebuffer with noise: a noise band on
# glass means that layer is the visible one and this init is running.
for fb in /sys/class/graphics/fb*; do
	n=${fb##*/}
	say "$n: $(cat $fb/name 2>/dev/null) $(cat $fb/virtual_size 2>/dev/null) stride $(cat $fb/stride 2>/dev/null)"
done
i=0
for fb in /dev/fb*; do
	if [ $i -gt 0 ]; then
		stride=$(cat /sys/class/graphics/${fb##*/}/stride 2>/dev/null)
		[ -n "$stride" ] && dd if=/dev/urandom of=$fb bs=$stride seek=1400 count=700 2>/dev/null \
			&& say "noise band written to $fb"
	fi
	i=$((i+1))
done

# Full dmesg into pmsg (ramoops) as well, for reading back from Gemian.
dmesg > /dev/pmsg0 2>/dev/null

# Bring-up: nothing is visible on glass yet, so prove life by a warm
# reboot after 15 s; RAM survives it and ramoops holds this boot's
# console for `mtk da peek` (docs/session-log.md, 2026-10-25).
REBOOT_AFTER=15
say "rebooting in $REBOOT_AFTER s (bring-up ramoops capture)"
sleep $REBOOT_AFTER
say "rebooting now"
sync
reboot -f
