#!/bin/busybox sh
# Cosmo bring-up initramfs (P1): prove the kernel is alive, on glass and in
# pstore. No root switch. The only eMMC write is the boot log into the
# raw `cache` partition (unused by Gemian), read back with mtk.
/bin/busybox --install -s /bin
export PATH=/bin
mkdir -p /proc /sys /dev /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null

# The console the kernel picked may be the unreachable UART; write to the
# framebuffer console and the kernel log (-> ramoops) explicitly.
say() { echo "$*" > /dev/tty0 2>/dev/null; echo "cosmo-init: $*" > /dev/kmsg 2>/dev/null; }

say "===== Cosmo mainline bring-up: initramfs reached ====="

# Watchdog failsafe (AGENTS.md rule 5, docs/safety-audit.md): from here on
# only this init feeds the SoC watchdog, so a stuck init or a hung kernel
# resets the board within ~31 s. cosmo.wdtest=1: arm it and never feed
# (escape test: the board must reset by itself).
WDT=/dev/watchdog0
[ -e $WDT ] || WDT=/dev/watchdog
if exec 3>"$WDT"; then
	say "watchdog $WDT owned by init (fed every 5 s)"
else
	say "WARNING: could not open $WDT - no timer failsafe"
fi
feed() { printf . >&3 2>/dev/null; }
if grep -qw cosmo.wdtest=1 /proc/cmdline; then
	say "ESCAPE TEST: watchdog armed and NOT fed - board must reset in ~31-62 s"
	while true; do sleep 60; done
fi

# ---- Root filesystem handoff (Debian on userdata) -------------------------
# Boots /sbin/init from the ext4 on `userdata` when it looks like a system.
# Tripwire: before the handoff, "COSMO-TRY" is written at 8 MiB into the raw
# `cache` partition; the root system's cosmo-boot-ok.service overwrites it
# with "COSMO-OK" once it is up. If a boot finds COSMO-TRY still there (the
# last handoff never reported in, e.g. it hung and was reset with the power
# key), this boot stays here in the rescue initramfs (USB + telnet) and the
# next one tries again. cosmo.noroot on the cmdline also stays here.
part() { # GPT name -> /dev/mmcblk0pN
	for b in /sys/class/block/mmcblk0p*; do
		grep -qx "PARTNAME=$1" "$b/uevent" 2>/dev/null && { echo "/dev/${b##*/}"; return; }
	done
}
FLAG_SEEK=16384 # 512-byte sectors = 8 MiB into cache (boot log uses 0-4 MiB)
flag_get() { dd if="$1" bs=512 skip=$FLAG_SEEK count=1 2>/dev/null | head -c 9; }
flag_set() { printf '%s' "$2" | dd of="$1" bs=512 seek=$FLAG_SEEK count=1 conv=sync,notrunc 2>/dev/null; sync; }
try_root() {
	grep -qw cosmo.noroot /proc/cmdline && { say "cosmo.noroot: staying in the initramfs"; return; }
	ROOTDEV=$(part userdata); CACHEDEV=$(part cache)
	[ -n "$ROOTDEV" ] && [ -n "$CACHEDEV" ] || { say "userdata/cache not found: staying here"; return; }
	if [ "$(flag_get "$CACHEDEV")" = "COSMO-TRY" ]; then
		say "last root boot never reported in: RESCUE initramfs (next boot tries again)"
		flag_set "$CACHEDEV" "COSMO-RSC"
		return
	fi
	mkdir -p /newroot
	mount -t ext4 -o rw,noatime "$ROOTDEV" /newroot 2>/dev/null || { say "no ext4 root on $ROOTDEV: staying here"; return; }
	if [ ! -x /newroot/sbin/init ] || [ ! -f /newroot/etc/os-release ]; then
		say "$ROOTDEV has no /sbin/init or os-release: staying here"
		umount /newroot
		return
	fi
	flag_set "$CACHEDEV" "COSMO-TRY"
	say "booting $(. /newroot/etc/os-release; echo "$PRETTY_NAME") from $ROOTDEV"
	feed
	# Hand the watchdog to systemd (RuntimeWatchdogSec): closing without the
	# magic character leaves it running, so a hang before systemd opens it
	# still resets the board.
	exec 3>&-
	for m in /dev /proc /sys; do
		mkdir -p "/newroot$m"
		mount -o move "$m" "/newroot$m" 2>/dev/null || umount -l "$m" 2>/dev/null
	done
	exec switch_root /newroot /sbin/init
}
try_root

say "$(uname -a)"
say "cmdline: $(cat /proc/cmdline)"
say "cpus online: $(cat /sys/devices/system/cpu/online)"
say "mem: $(grep -E 'MemTotal' /proc/meminfo)"
say "drm: $(ls /sys/class/drm 2>/dev/null | tr '\n' ' ')"
say "mmc: $(ls /sys/class/block 2>/dev/null | grep -c mmcblk0p) eMMC partitions seen"
say "deferred: $(cat /sys/kernel/debug/devices_deferred 2>/dev/null | wc -l) (debugfs may be absent)"
dmesg | grep -iE 'error|fail|unable|deferred' | tail -n 25 > /dev/tty0 2>/dev/null

# Full dmesg into pmsg (ramoops) as well, for reading back from Gemian.
dmesg > /dev/pmsg0 2>/dev/null

# Bring-up diagnostics on glass: why devices wait, and the USB/phy story.
mkdir -p /sys/kernel/debug
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
say "--- devices_deferred ---"
cat /sys/kernel/debug/devices_deferred > /dev/tty0 2>/dev/null
say "--- usb/mtu3/phy/power lines ---"
dmesg | grep -iE 'mtu3|ssusb|11201000|t-phy|tphy|udc|gadget|g_ether|power-controller|mmsys|cmdq|gce' | tail -n 20 > /dev/tty0 2>/dev/null

# Bring-up network over USB: g_ether (CDC ECM). The Cosmo is 10.15.19.83;
# udhcpd hands the host 10.15.19.84 (no router or DNS, so the host keeps
# its own default route). Shell: telnet 10.15.19.83 (cable-only, no auth).
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
say "block: $(ls /sys/class/block 2>/dev/null | tr '\n' ' ')"
n=0
while [ ! -e /sys/class/net/usb0 ] && [ $n -lt 20 ]; do feed; sleep 1; n=$((n+1)); done
if [ -e /sys/class/net/usb0 ]; then
	ifconfig usb0 10.15.19.83 netmask 255.255.255.0 up
	printf '%s\n' "start 10.15.19.84" "end 10.15.19.84" "interface usb0" \
		"max_leases 1" "lease_file /tmp/udhcpd.leases" \
		"option subnet 255.255.255.0" > /tmp/udhcpd.conf
	touch /tmp/udhcpd.leases
	udhcpd /tmp/udhcpd.conf && say "udhcpd on usb0"
	telnetd -l /bin/sh && say "telnetd up: telnet 10.15.19.83"
else
	say "no usb0 after 20 s"
fi
say "udc: $(ls /sys/class/udc 2>/dev/null | tr '\n' ' ')"

# USB report on a clean screen: kernel messages off the console (they still
# go to dmesg), then one page that fits the glass, so one photo shows it.
dmesg -n 1
printf '\033[2J\033[H' > /dev/tty0 2>/dev/null
{
	echo "=== USB report at $(cut -d' ' -f1 /proc/uptime) s ==="
	echo "udc: $(ls /sys/class/udc 2>/dev/null | tr '\n' ' ')"
	U=/sys/bus/platform/devices/11201000.usb
	echo "11201000.usb driver: $(readlink $U/driver 2>/dev/null | sed 's|.*/||')"
	for l in $U/supplier:*; do
		[ -e "$l" ] && echo "  supplier ${l##*supplier:}: $(cat $l/status 2>/dev/null)"
	done
	P=/sys/bus/platform/devices/11f40000.t-phy
	echo "t-phy driver: $(readlink $P/driver 2>/dev/null | sed 's|.*/||')  phys: $(ls /sys/class/phy 2>/dev/null | tr '\n' ' ')"
	echo "--- devices_deferred ---"
	head -n 8 /sys/kernel/debug/devices_deferred 2>/dev/null
	echo "--- dmesg usb/phy (no sync_state) ---"
	dmesg | grep -iE 'mtu3|11201000|tphy|t-phy|VA09|g_ether|udc' | grep -v sync_state | tail -n 14
} > /dev/tty0 2>/dev/null

# Boot log to the raw `cache` partition (4 MiB, zero-padded), so it can be
# read with `mtk ro 4747952128 4194304 <file>` (cache = sector 9273344)
# from Dragon instead of photographing the
# screen. Written only if the partition name checks out.
log_to_emmc() {
	for b in /sys/class/block/mmcblk0p*; do
		grep -qx 'PARTNAME=cache' $b/uevent 2>/dev/null || continue
		{
			echo "COSMO-LOG $1 uptime $(cut -d' ' -f1 /proc/uptime)"
			echo "--- udc: $(ls /sys/class/udc 2>/dev/null | tr '\n' ' ')"
			cat /sys/kernel/debug/devices_deferred 2>/dev/null
			echo "--- dmesg"
			dmesg
			echo "COSMO-LOG-END"
			head -c 4194304 /dev/zero
		} | head -c 4194304 > /dev/${b##*/} && sync
		say "boot log ($1) written to ${b##*/} (cache)"
		return
	done
	say "cache partition not found - no log written"
}
log_to_emmc first
feed

i=0
while true; do
	feed
	sleep 5
	i=$((i+1))
	[ $i -eq 8 ] && log_to_emmc late
	[ $((i % 6)) -eq 0 ] && echo "cosmo-init: alive, uptime $(cut -d' ' -f1 /proc/uptime) s" > /dev/kmsg
done
