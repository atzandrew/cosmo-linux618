<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xkbConfigRegistry SYSTEM "xkb.dtd">
<!-- Cosmo Communicator keyboard layout entry for libxkbregistry.
     Installed to /etc/xkb/rules/evdev.xml by cosmo-gnome-keys.sh.
     The symbols file is /usr/share/X11/xkb/symbols/cosmo. -->
<xkbConfigRegistry version="1.1">
  <modelList/>
  <layoutList>
    <layout>
      <configItem>
        <name>cosmo</name>
        <shortDescription>cosmo</shortDescription>
        <description>Cosmo English (UK)</description>
      </configItem>
      <variantList>
        <variant>
          <configItem>
            <name>us</name>
            <description>Cosmo English (US)</description>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>uk-ps16</name>
            <description>Cosmo English (UK, dead keys on Z)</description>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>de</name>
            <description>Cosmo German</description>
            <languageList><iso639Id>ger</iso639Id></languageList>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>ch-de</name>
            <description>Cosmo Swiss German</description>
            <languageList><iso639Id>ger</iso639Id></languageList>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>at</name>
            <description>Cosmo Austrian</description>
            <languageList><iso639Id>ger</iso639Id></languageList>
          </configItem>
        </variant>
      </variantList>
    </layout>
  </layoutList>
  <optionList/>
</xkbConfigRegistry>
